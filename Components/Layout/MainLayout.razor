@inherits LayoutComponentBase
@using MudBlazor

@* Обязательные сервис-провайдеры MudBlazor *@
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* 1. Верхняя панель (Header) в строгом Slate-Blue стиле *@
    <MudAppBar Elevation="1" Dense="true" Style="background-color: #1e293b; color: white;">
        <MudText Typo="Typo.subtitle1" Class="ml-3">
            <b>ASU Generator</b> <span style="font-size: 11px; opacity: 0.7; padding-left: 8px;">v1.0.0</span>
        </MudText>
        <MudSpacer />
        @* Замена старой ссылки About на аккуратную кнопку документации *@
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.HelpOutline" href="/pricing" Size="Size.Small">
            Документация
        </MudButton>
    </MudAppBar>

    @* 2. Боковая панель навигации (Левое меню) *@
    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="@DrawerVariant.Persistent" Style="background-color: var(--mud-palette-background-grey);">
        <NavMenu />
    </MudDrawer>

    @* 3. Центральная рабочая зона, которая подстраивается под размеры экрана *@
    <MudMainContent Class="d-flex flex-column" Style="min-height: 100vh; padding-top: 48px;">

        @* Контент текущей открытой страницы *@
        <div class="flex-grow-1 pa-1">
            @Body
        </div>

        @* 4. ЮРИДИЧЕСКИЙ ФУТЕР: Жестко прижат к низу, ссылки ведут на новую Legal.razor *@
        <footer class="mt-auto pa-4 mud-background-gray d-flex justify-space-between align-center" style="border-top: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-background-grey); font-size: 13px;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                © @DateTime.Now.Year asugenerator.ru. Все права защищены. Разработано Ведущим инженером АСУ ТП.
            </MudText>
            <div class="d-flex gap-4">
                @* НОВАЯ ССЫЛКА НА КОНТАКТЫ *@
                <MudLink href="contacts" Color="Color.Secondary" Underline="Underline.Hover" Style="font-size: 12px; font-weight: bold;">
                    Контакты и реквизиты
                </MudLink>
                <MudLink href="legal/privacy" Color="Color.Secondary" Underline="Underline.Hover" Style="font-size: 12px; font-weight: bold;">
                    Политика конфиденциальности
                </MudLink>
                <MudLink href="legal/offer" Color="Color.Secondary" Underline="Underline.Hover" Style="font-size: 12px; font-weight: bold;">
                    Пользовательское соглашение
                </MudLink>
            </div>
        </footer>


    </MudMainContent>
</MudLayout>

@* ИСПРАВЛЕНО: Интеллектуальный блок контроля SignalR-соединения под плохую связь *@
<div id="components-reconnect-modal" class="style-reconnect-modal">
    <div class="style-reconnect-content">
        <div class="spinner-mint"></div>
        <p><b>Слабый сигнал связи.</b> Восстанавливаем соединение с сервером АСУ ТП...</p>
    </div>
</div>

<style>
    /* Прячем дефолтную серую плашку Blazor */
    #components-reconnect-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        z-index: 99999;
        background-color: rgba(15, 23, 42, 0.85); /* Полупрозрачный slate-фон */
        align-items: center;
        justify-content: center;
    }
        /* Показываем плашку ТОЛЬКО во время реального разрыва сети */
        #components-reconnect-modal.components-reconnect-show {
            display: flex;
        }

    .style-reconnect-content {
        background: #1e293b;
        color: white;
        padding: 24px;
        border-radius: 8px;
        border: 2px solid #3cb890; /* Ваша фирменная мятная рамка */
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        font-family: sans-serif;
    }
    /* Мятный спиннер загрузки */
    .spinner-mint {
        border: 4px solid rgba(255,255,255,0.1);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border-left-color: #3cb890;
        animation: spin 1s linear infinite;
        margin: 0 auto 12px auto;
    }
    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
    /* ======================================== */
    /* КОМПАКТНЫЙ РЕЖИМ В СТИЛЕ 1С              */
    /* ======================================== */

    /* Строки таблиц */
    .mud-table-cell {
        padding: 2px 6px !important;
        font-size: 12px !important;
    }

    .mud-table-head .mud-table-cell {
        padding: 3px 6px !important;
        font-weight: bold;
        background-color: #f0f0f0;
    }

    /* Карточки */
    .mud-card {
        margin-bottom: 4px !important;
    }

    .mud-card-content {
        padding: 4px 8px !important;
    }

    /* Поля ввода */
    .mud-input-control {
        margin-top: 1px !important;
        margin-bottom: 1px !important;
    }

    .mud-input {
        font-size: 12px !important;
        padding: 2px 4px !important;
    }

    /* Кнопки */
    .mud-button-root {
        padding: 3px 8px !important;
        font-size: 12px !important;
        min-height: 26px !important;
    }

    /* Табы */
    .mud-tabs .mud-tab {
        padding: 3px 10px !important;
        font-size: 12px !important;
        min-height: 28px !important;
    }

    /* Грид */
    .mud-grid {
        gap: 2px !important;
    }

    .mud-grid-item {
        padding: 1px 2px !important;
    }

    /* Общий шрифт */
    body {
        font-size: 12px;
        line-height: 1.3;
    }

    h1, h2, h3, h4, h5, h6 {
        margin: 4px 0 !important;
    }

    .mud-container {
        padding: 4px 8px !important;
    }
</style>

