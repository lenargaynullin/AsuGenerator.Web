@using MudBlazor

@* Брендированная шапка бокового меню *@
<div class="pa-4 d-flex align-center justify-start mud-theme-primary" style="height: 64px; border-bottom: 1px solid var(--mud-palette-lines-default);">
    <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Inherit" Class="mr-2" Size="Size.Medium" />
    <MudText Typo="Typo.h6" Color="Color.Inherit"><b>AsuGenerator</b></MudText>
</div>

<MudNavMenu Bordered="true" Class="pa-2">

    @* ========== 🟢 ОСНОВНОЕ: КОНФИГУРАТОР ПЛК ========== *@
    <MudText Typo="Typo.overline" Class="px-3 mt-2 mb-1" Style="color: #3cb890; font-weight: bold; font-size: 10px;">
        КОНФИГУРАТОР СИСТЕМ ПЛК
    </MudText>
    <MudNavLink Href="/plc-configurator" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory" IconColor="Color.Success">
        Конфигуратор ПЛК
    </MudNavLink>
    <MudNavLink Href="/plc-comparison" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BarChart" IconColor="Color.Info">
        Сравнение ПЛК (ТКП)
    </MudNavLink>

    <MudDivider Class="my-2" />

    @* ========== 🔵 КОНФИГУРАТОРЫ ШКАФОВ ========== *@
    <MudText Typo="Typo.overline" Class="px-3 mb-1" Style="color: #94a3b8; font-weight: bold; font-size: 10px;">
        КОНФИГУРАТОРЫ ШКАФОВ
    </MudText>
    <MudNavLink Href="/configurator" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build" IconColor="Color.Primary">
        Конфигуратор шкафа
    </MudNavLink>
    <MudNavLink Href="/import-spec" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContentPaste" IconColor="Color.Success">
        Импорт спецификации
    </MudNavLink>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Info">
        Мои проекты
    </MudNavLink>
    <MudNavLink Href="/standard-cabinets" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory2" IconColor="Color.Default">
        Типовые шкафы
    </MudNavLink>

    <MudDivider Class="my-2" />

    @* ========== ⚙️ БАЗЫ ДАННЫХ ========== *@
    <MudText Typo="Typo.overline" Class="px-3 mb-1" Style="color: #64748b; font-weight: bold; font-size: 10px;">
        БАЗЫ ДАННЫХ
    </MudText>
    <MudNavLink Href="/db-uploader" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SettingsSuggest" IconColor="Color.Warning">
        Загрузка каталога ПЛК
    </MudNavLink>

    <MudDivider Class="my-2" />

    @* ========== 📄 ОСТАЛЬНОЕ ========== *@
    <MudText Typo="Typo.overline" Class="px-3 mb-1" Style="color: #475569; font-weight: bold; font-size: 10px;">
        ДОКУМЕНТЫ И СВЯЗЬ
    </MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" IconColor="Color.Default">
        Главная страница
    </MudNavLink>
    <MudNavLink Href="/pricing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success">
        Тарифы и Бизнес
    </MudNavLink>
    <MudNavLink Href="/standards" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook" IconColor="Color.Warning">
        Стандарты ГОСТ
    </MudNavLink>
    <MudNavLink Href="/feedback" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Feedback" IconColor="Color.Default">
        Отзывы и предложения
    </MudNavLink>

</MudNavMenu>