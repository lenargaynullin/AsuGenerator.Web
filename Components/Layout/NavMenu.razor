@using MudBlazor

@* Брендированная шапка бокового меню *@
<div class="pa-4 d-flex align-center justify-start mud-theme-primary" style="height: 64px; border-bottom: 1px solid var(--mud-palette-lines-default);">
    <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Inherit" Class="mr-2" Size="Size.Medium" />
    <MudText Typo="Typo.h6" Color="Color.Inherit"><b>AsuGenerator</b></MudText>
</div>

@* Навигационное меню *@
<MudNavMenu Bordered="true" Class="pa-2">

    @* Ссылка на главную страницу (Лендинг/Презентация) *@
    <MudNavLink href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" IconColor="Color.Default">
        Главная страница
    </MudNavLink>

    @* Ссылка на сам рабочий конфигуратор с вкладками Конструктив/Оборудование *@
    <MudNavLink href="configurator" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build" IconColor="Color.Primary">
        Конфигуратор шкафа
    </MudNavLink>

    @* Ссылка на конфигуратор ПЛК *@
    <MudNavLink href="plc-configurator" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory" IconColor="Color.Info">
        Конфигуратор ПЛК
    </MudNavLink>

    @* Ссылка на конфигуратор ПЛК *@
    <MudNavLink href="import-specification" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Memory" IconColor="Color.Info">
        Импорт спецификации
    </MudNavLink>

    @* Ссылка на панель управления проектами инженера *@
    <MudNavLink href="dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Info">
        Мои проекты
    </MudNavLink>

    @* Ссылка на коммерческую страницу с тарифами и запросом счета по ИНН *@
    <MudNavLink href="pricing" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success">
        Тарифы и Бизнес
    </MudNavLink>

    @* Ссылка на страницу блога со статьями *@
    <MudNavLink href="blog" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RssFeed" IconColor="Color.Warning">
        Блог и статьи
    </MudNavLink>

    <MudNavLink href="standards" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook" IconColor="Color.Warning">
        Стандарты ГОСТ
    </MudNavLink>

    <MudNavLink Href="/standard-cabinets" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory2">
        Типовые шкафы
    </MudNavLink>

    <MudNavLink Href="/feedback" Icon="@Icons.Material.Filled.Feedback" Match="NavLinkMatch.Prefix">
        Отзывы и предложения
    </MudNavLink>

</MudNavMenu>
