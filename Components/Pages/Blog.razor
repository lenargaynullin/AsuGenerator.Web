@page "/blog"
@using MudBlazor

<PageTitle>Блог и полезные материалы — ASU Generator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10 mb-10">
    <div class="text-center mb-8">
        <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2"><b>Блог инженера АСУ ТП</b></MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Полезные статьи, разборы ГОСТов, методики расчетов и автоматизации проектирования</MudText>
    </div>

    <MudGrid>
        @foreach (var article in _articles)
        {
            <MudItem xs="12" md="4">
                <MudCard Outlined="true" Class="d-flex flex-column justify-space-between pa-4 h-100" Style="background-color: white; min-height: 280px;">
                    <MudCardContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@article.Date.ToString("dd.MM.yyyy") | Чтение: @article.ReadTime</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2 mb-2"><b>@article.Title</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@article.PreviewText</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" href="@($"/blog/{article.Slug}")">
                            Читать статью
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

