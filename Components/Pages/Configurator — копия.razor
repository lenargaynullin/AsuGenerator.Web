@page "/configurator"
@using AsuGenerator.Web.Services
@using System.IO
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services.Strategies
@inject ExcelParserService Parser
@inject CalculationEngine Engine
@inject DocumentGenerator DocGen
@inject CabinetStrategyFactory StrategyFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Конфигуратор шкафа - AsuGenerator</PageTitle>

<div class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary"><b>Генератор спецификаций шкафов автоматизации</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Автоматический подбор оборудования по параметрам. Скачивание спецификации в Excel.</MudText>

    <MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mb-6" PanelClass="pa-6">

        <!-- Вкладка 1: Конструктив -->
        <MudTabPanel Text="Конструктив" Icon="@Icons.Material.Filled.SettingsSuggest">
            <MudGrid>
                <MudItem Xs="12" Md="12">
                    <div class="d-flex flex-column gap-4">
                  
                                        <MudSelect T="string" Label="Производитель" @bind-Value="baseConfig.Manufacturer" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("IEK")">IEK</MudSelectItem>
                                            <MudSelectItem Value="@("ПРОВЕНТО")">ПРОВЕНТО</MudSelectItem>
                                            <MudSelectItem Value="@("По проекту")">По проекту</MudSelectItem>
                                        </MudSelect>

                                        <MudSelect T="string" Label="Тип монтажа" @bind-Value="baseConfig.MountType" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("Навесной")">Навесной</MudSelectItem>
                                            <MudSelectItem Value="@("Напольный")">Напольный</MudSelectItem>
                                        </MudSelect>

                                        <MudSelect T="string" Label="Степень защиты" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("IP54")">IP54</MudSelectItem>
                                            <MudSelectItem Value="@("IP66")">IP66</MudSelectItem>
                                        </MudSelect>

                                        <MudSelect T="string" Label="Габариты (В×Ш×Г)" @bind-Value="selectedDimensions" Variant="Variant.Outlined" Dense="true">
                                            @if (baseConfig.IpRating == "IP54")
                                            {
                                                <MudSelectItem Value="@("400×300×220")">400×300×220 мм</MudSelectItem>
                                                <MudSelectItem Value="@("600×600×250")">600×600×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("800×650×250")">800×650×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1000×650×285")">1000×650×285 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1200×750×300")">1200×750×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1400×650×285")">1400×650×285 мм</MudSelectItem>
                                            }
                                            else if (baseConfig.IpRating == "IP66")
                                            {
                                                <MudSelectItem Value="@("400×300×200")">400×300×200 мм</MudSelectItem>
                                                <MudSelectItem Value="@("600×400×250")">600×400×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("800×600×300")">800×600×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1000×800×300")">1000×800×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1200×800×400")">1200×800×400 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1400×800×300")">1400×800×300 мм</MudSelectItem>
                                            }
                                        </MudSelect>

                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasPocket" Label="Карман для документов" Color="Color.Primary" />
                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasPocket" Label="Боковые панели" Color="Color.Primary" />
                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasPlinth" Label="Ручка двери" Color="Color.Primary" />
                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasPlinth" Label="Полка" Color="Color.Primary" />
                                        <MudSelect T="string" Label="Высота цоколя" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("100 мм")">IP54</MudSelectItem>
                                            <MudSelectItem Value="@("200 мм")">IP66</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string" Label="Количество сторон шкафа" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("1")">1</MudSelectItem>
                                            <MudSelectItem Value="@("2")">2</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string" Label="Вентилятор" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("1")">FA 12.230</MudSelectItem>
                                            <MudSelectItem Value="@("2")">FA 13.230</MudSelectItem>
                                            <MudSelectItem Value="@("1")">FA 15.230</MudSelectItem>
                                            <MudSelectItem Value="@("2")">FA 08.230</MudSelectItem>
                                            <MudSelectItem Value="@("1")">FA 20.230</MudSelectItem>
                                            <MudSelectItem Value="@("2")">FA 13.230</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string" Label="Панель вентиляционная потолочная" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("1")">RV 32.23 L</MudSelectItem>
                                            <MudSelectItem Value="@("2")">RV 38.38 L</MudSelectItem>
                                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Build" OnClick="ProcessUiCalculation" Class="py-3 mt-2">
                            Рассчитать
                        </MudButton>
                        </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Вкладка 2: Оборудование -->
        <MudTabPanel Text="Оборудование" Icon="@Icons.Material.Filled.SettingsSuggest">
            <MudGrid>
                <MudItem Xs="12" Md="12">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle1"><b>Параметры конфигурации шкафа:</b></MudText>
                        <MudExpansionPanels MultiExpansion="true">
                            <MudExpansionPanel Text="Общие параметры шкафа" IsInitiallyExpanded="false" Class="mb-2">
                                <TitleContent>
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1"><b>Общие параметры шкафа (Электротехника и климат)</b></MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Class="pa-2">

                                        @* Колонка 1: Параметры питания и защиты *@
                                        <MudItem xs="12" md="4" Class="d-flex flex-column gap-3" Style="border-right: 1px solid var(--mud-palette-lines-inputs); padding-right: 20px;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>1. Электропитание и нагрузки</b></MudText>

                                            <div class="d-flex flex-column gap-1">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Номинальное напряжение питания</MudText>
                                                <MudRadioGroup T="string" @bind-Value="baseConfig.Voltage" Class="d-flex gap-4">
                                                    <MudRadio Value="@("380")" Color="Color.Primary" Dense="true">~380 В (3 ф.)</MudRadio>
                                                    <MudRadio Value="@("220")" Color="Color.Primary" Dense="true">~220 В (1 ф.)</MudRadio>
                                                    <MudRadio Value="@("24")" Color="Color.Primary" Dense="true">=24 В</MudRadio>
                                                </MudRadioGroup>
                                            </div>

                                            <MudGrid Spacing="2">
                                                <MudItem xs="6">
                                                    <MudNumericField T="int" Label="Ток ввода, А" @bind-Value="baseConfig.InputCurrent" Min="1" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudSelect T="string" Label="Категория надежности" @bind-Value="baseConfig.PowerCategory" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem Value="@("I")">I категория (АВР)</MudSelectItem>
                                                        <MudSelectItem Value="@("II")">II категория</MudSelectItem>
                                                        <MudSelectItem Value="@("III")">III категория</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>

                                            <MudSelect T="string" Label="Тип системы заземления" @bind-Value="baseConfig.EarthingSystem" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                <MudSelectItem Value="@("TN-S")">TN-S (раздельные N и PE)</MudSelectItem>
                                                <MudSelectItem Value="@("TN-C-S")">TN-C-S</MudSelectItem>
                                                <MudSelectItem Value="@("TN-C")">TN-C (совмещенный PEN)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        @* Колонка 2: Климат и окружающая среда *@
                                        <MudItem xs="12" md="4" Class="d-flex flex-column gap-3" Style="border-right: 1px solid var(--mud-palette-lines-inputs); padding-left: 20px; padding-right: 20px;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>2. Климатическое исполнение</b></MudText>

                                            <MudSelect T="string" Label="Климатическое исполнение по ГОСТ 15150" @bind-Value="baseConfig.ClimateExecution" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                <MudSelectItem Value="@("УХЛ4")">УХЛ4 (Отапливаемые помещения)</MudSelectItem>
                                                <MudSelectItem Value="@("УХЛ1")">УХЛ1 (На открытом воздухе)</MudSelectItem>
                                                <MudSelectItem Value="@("У1")">У1 (Умеренный климат, улица)</MudSelectItem>
                                                <MudSelectItem Value="@("Т3")">Т3 (Тропический)</MudSelectItem>
                                            </MudSelect>

                                            <div class="d-flex flex-column gap-1 mt-1">
                                                <MudSwitch T="bool" @bind-Value="baseConfig.HasHeater" Label="Обогрев шкафа (антиконденсат)" Color="Color.Primary" Dense="true" />
                                                <MudSwitch T="bool" @bind-Value="baseConfig.HasVentilation" Label="Принудительная вентиляция" Color="Color.Primary" Dense="true" />
                                                <MudSwitch T="bool" @bind-Value="baseConfig.HasLighting" Label="Внутреннее освещение шкафа" Color="Color.Primary" Dense="true" />
                                            </div>

                                            @if (baseConfig.HasHeater || baseConfig.HasVentilation)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Info" Class="font-italic">
                                                    * Термостаты управления микроклиматом добавятся в спецификацию автоматически.
                                                </MudText>
                                            }
                                        </MudItem>

                                        @* Колонка 3: Конструктивные особенности ввода *@
                                        <MudItem xs="12" md="4" Class="d-flex flex-column gap-3" Style="padding-left: 20px;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>3. Монтаж и кабельный ввод</b></MudText>

                                            <MudSelect T="string" Label="Направление ввода кабелей" @bind-Value="baseConfig.CableEntryDirection" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                <MudSelectItem Value="@("Bottom")">Снизу шкафа (Стандарт)</MudSelectItem>
                                                <MudSelectItem Value="@("Top")">Сверху шкафа</MudSelectItem>
                                                <MudSelectItem Value="@("Both")">Комбинированный (Сверху и Снизу)</MudSelectItem>
                                            </MudSelect>

                                            <MudGrid Spacing="2">
                                                <MudItem xs="7">
                                                    <MudSelect T="string" Label="Тип кабельных вводов" @bind-Value="baseConfig.GlandType" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem Value="@("Пластик")">Пластиковые сальники (MG)</MudSelectItem>
                                                        <MudSelectItem Value="@("Латунь")">Латунные (PG)</MudSelectItem>
                                                        <MudSelectItem Value="@("Кабельная плата")">Кабельная плата (Провенто)</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="5">
                                                    <MudNumericField T="int" Label="Кол-во вводов" @bind-Value="baseConfig.GlandsCount" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                                </MudItem>
                                            </MudGrid>

                                            <MudSelect T="string" Label="Цвет окраски шкафа (RAL)" @bind-Value="baseConfig.RalColor" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                <MudSelectItem Value="@("7035")">RAL 7035 (Светло-серый, стандарт)</MudSelectItem>
                                                <MudSelectItem Value="@("7021")">RAL 7021 (Темно-серый)</MudSelectItem>
                                                <MudSelectItem Value="@("7032")">RAL 7032 (Гравийно-серый)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                    </MudGrid>
                                </ChildContent>
                            </MudExpansionPanel>

                            <MudExpansionPanel Text="Программируемые контроллеры и модули" MaxHeight="1000">
                                <TitleContent>
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Primary" Class="mr-2" />
                                        <MudText Typo="Typo.subtitle1"><b>Программируемые контроллеры и модули</b></MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid Class="pa-2">

                                        @* Левая колонка: Базовое железо *@
                                        <MudItem xs="12" md="6" Class="d-flex flex-column gap-3" Style="border-right: 1px solid var(--mud-palette-lines-inputs); padding-right: 24px;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Базовая конфигурация</b></MudText>

                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="5">
                                                    <MudSelect T="string" Label="Производитель" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem Value="@("ОВЕН")" />
                                                        <MudSelectItem Value="@("Segnetics")" />
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="5">
                                                    <MudSelect T="string" Label="Контроллер" @bind-Value="baseConfig.PlcType" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem Value="@("ПР200")">ПР200</MudSelectItem>
                                                        <MudSelectItem Value="@("ПЛК110")">ПЛК110</MudSelectItem>
                                                        <MudSelectItem Value="@("ПЛК160")">ПЛК160</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="2">
                                                    <MudNumericField T="int" Label="Кол-во" Min="1" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                                                </MudItem>
                                            </MudGrid>

                                            <MudSelect T="string" Label="Протокол связи основного ПЛК" @bind-Value="baseConfig.Protocol" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                                <MudSelectItem Value="@("Modbus RTU")">Modbus RTU (RS-485)</MudSelectItem>
                                                <MudSelectItem Value="@("Modbus TCP")">Modbus TCP (Ethernet)</MudSelectItem>
                                                <MudSelectItem Value="@("Нет")">Без сетевого интерфейса</MudSelectItem>
                                            </MudSelect>

                                            <div class="mt-auto pt-4">
                                                <MudAlert Severity="Severity.Info" Dense="true" Class="mud-width-full" Icon="@Icons.Material.Filled.AutoFixHigh">
                                                    Модули расширения под количество сигналов рассчитаются автоматически.
                                                </MudAlert>
                                            </div>
                                        </MudItem>

                                        @* Правая колонка: Расчет по сигналам *@
                                        <MudItem xs="12" md="6" Class="d-flex flex-column gap-3" Style="padding-left: 24px;">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Ёмкость сигналов ввода-вывода (I/O)</b></MudText>

                                            <MudGrid Spacing="2">
                                                @* Аналоговые входы *@
                                                <MudItem xs="6">
                                                    <MudNumericField T="int" Label="AI (4-20 мА)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HideSpinButtons="false" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudNumericField T="int" Label="AI (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HideSpinButtons="false" />
                                                </MudItem>

                                                @* Дискретные сигналы *@
                                                <MudItem xs="6">
                                                    <MudNumericField T="int" Label="DI (Сухой контакт)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HideSpinButtons="false" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudNumericField T="int" Label="DO (Релейные/Транз.)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HideSpinButtons="false" />
                                                </MudItem>
                                            </MudGrid>

                                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                                * Указывайте общее число физических каналов на объекте. Система заложит необходимый резерв на клеммниках согласно ГОСТ.
                                            </MudText>
                                        </MudItem>

                                    </MudGrid>
                                </ChildContent>
                            </MudExpansionPanel>


                            

                            <!-- Панель 2: Силовая часть -->
                            <MudExpansionPanel Text="Защита и коммутация (Автоматы, реле, БП)">
                                <!-- Тут поля для выбора автоматов КЭАЗ и БП Mean Well -->
                                <MudText Typo="Typo.subtitle1" Class="mt-4">Отходящие линии обогрева</MudText>

                                <MudSimpleTable Dense="true" Hover="true" Bordered="true" Outlined="true" Class="mt-2">
                                    <thead>
                                        <tr>
                                            <th style="width:5%; text-align:center;"><MudIcon Icon="@Icons.Material.Filled.PowerSettingsNew" Size="Size.Small" /></th>
                                            <th style="width:8%">Поз. ОУ</th>
                                            <th style="width:12%; text-align:center">Диф. защита</th>
                                            <th style="width:12%">Полюса</th>
                                            <th style="width:14%">Номинал, А</th>
                                            <th style="width:10%">Хар-ка</th>
                                            <th style="width:12%">Iк.з., кА</th>
                                            <th style="width:12%; text-align:center">Контактор</th>
                                            <th style="width:15%; text-align:center">Терморегулятор</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < heatingLines.Count; i++)
                                        {
                                            var line = heatingLines[i];
                                            var rowStyle = line.IsEnabled ? "" : "opacity: 0.4; background-color: var(--mud-palette-background-grey);";
                                            <tr style="@rowStyle">
                                                <td style="text-align:center">
                                                    <MudCheckBox @bind-Value="line.IsEnabled" Color="Color.Primary" Dense="true" />
                                                </td>
                                                <td><MudText Typo="Typo.body2"><b>@line.Designation</b></MudText></td>
                                                <td style="text-align:center">
                                                    @if (line.Designation != "QF")
                                                    {
                                                        <MudCheckBox @bind-Value="line.HasRCD" Color="Color.Error" Dense="true" Disabled="@(!line.IsEnabled)" />
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Вводной ВА</MudText>
                                                    }
                                                </td>
                                                <td>
                                                    <MudSelect T="int" @bind-Value="line.Poles" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(!line.IsEnabled)">
                                                        <MudSelectItem T="int" Value="1">1P</MudSelectItem>
                                                        <MudSelectItem T="int" Value="2">2P</MudSelectItem>
                                                        <MudSelectItem T="int" Value="3">3P</MudSelectItem>
                                                        <MudSelectItem T="int" Value="4">4P</MudSelectItem>
                                                    </MudSelect>
                                                </td>
                                                <td>
                                                    <MudSelect T="int" @bind-Value="line.Current" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(!line.IsEnabled)">
                                                        @foreach (var amp in new int[] { 1, 2, 3, 4, 6, 10, 16, 20, 25, 32, 40, 50, 63 })
                                                        {
                                                            <MudSelectItem T="int" Value="@amp">@amp А</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </td>
                                                <td>
                                                    <MudSelect T="string" @bind-Value="line.Curve" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(!line.IsEnabled)">
                                                        <MudSelectItem T="string" Value="@("A")">A</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("B")">B</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("C")">C</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("D")">D</MudSelectItem>
                                                    </MudSelect>
                                                </td>
                                                <td>
                                                    <MudSelect T="double" @bind-Value="line.IkZ" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(!line.IsEnabled)">
                                                        <MudSelectItem T="double" Value="4.5">4.5 кА</MudSelectItem>
                                                        <MudSelectItem T="double" Value="6">6.0 кА</MudSelectItem>
                                                        <MudSelectItem T="double" Value="10">10.0 кА</MudSelectItem>
                                                    </MudSelect>
                                                </td>
                                                <td style="text-align:center">
                                                    @if (line.Designation != "QF")
                                                    {
                                                        <MudCheckBox @bind-Value="line.HasContactor" Color="Color.Info" Dense="true" Disabled="@(!line.IsEnabled)" />
                                                    }
                                                    else
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                                                    }
                                                </td>
                                                <td style="text-align:center">
                                                    @if (line.Designation != "QF")
                                                    {
                                                        <MudCheckBox @bind-Value="line.HasThermostat" Color="Color.Warning" Dense="true" Disabled="@(!line.IsEnabled)" />
                                                    }
                                                    else
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>

                            </MudExpansionPanel>

                            <!-- Панель 3: Клеммы -->
                            <MudExpansionPanel Text="Клеммные ряды и монтажные материалы" IsInitiallyExpanded="false" Class="mb-2">
