@code {
    @code {
        private void OnIpRatingChanged(string newIpRating)
        {
            // Присваиваем новое значение степени защиты
            baseConfig.IpRating = newIpRating;

            // Выставляем нижнее (последнее) значение габаритов в зависимости от выбора
            if (newIpRating == "IP54")
            {
                selectedDimensions = "400×300×220";
            }
            else if (newIpRating == "IP66")
            {
                selectedDimensions = "400×300×200";
            }
        }
    }

    private BaseCabinetConfig baseConfig = new();

    private string selectedDimensions = "500×400×220";
    private string selectedCabinetType = "Шкаф управления вентиляцией (ШУВ)";
    private string heaterType = "Водяной";
    private VentAvtomatikaConfig? loadedConfig;
    private List<SelectedComponent> matchedComponents = new();
    private bool supplyFan = true;
    private bool hasVfd = false;
    private bool hasHeaterPump = false;
    private bool hasDamper = false;
    private bool hasHumidifierPump = false;
    private bool hasAirConditioner = false;
    private bool has3WayValve = false;
    private List<HeatingLine> heatingLines = new()
    {
        new() { Designation = "QF" },
        new() { Designation = "QF1" },
        new() { Designation = "QF2" },
        new() { Designation = "QF3" },
        new() { Designation = "QF4" },
        new() { Designation = "QF5" },
        new() { Designation = "QF6" },
        new() { Designation = "QF7" },
        new() { Designation = "QF8" },
        new() { Designation = "QF9" },
        new() { Designation = "QF10" },
        new() { Designation = "QF11" },
        new() { Designation = "QF12" },
    };
    private string _previousIp = "IP54";

    private void ProcessUiCalculation()
    {
        try
        {   
            var dims = selectedDimensions.Split('×');
            if (dims.Length == 3)
            {
                baseConfig.Height = int.Parse(dims[0]);
                baseConfig.Width = int.Parse(dims[1]);
                baseConfig.Depth = int.Parse(dims[2]);
            }



            var input = new UiConfigInput
            {
                SupplyFan = supplyFan,
                HasVfd = hasVfd,
                HasHeaterPump = hasHeaterPump,
                HasDamper = hasDamper,
                HasHumidifierPump = hasHumidifierPump,
                HasAirConditioner = hasAirConditioner,
                Has3WayValve = has3WayValve,
                TechnologyType = heaterType,
                ProjectNumber = "Конфиг-" + DateTime.Now.ToString("ddMM"),
                BaseConfig = baseConfig,
                HeatingLines = heatingLines.Where(l => l.IsEnabled).ToList()
            };

            loadedConfig = new VentAvtomatikaConfig
            {
                ClientName = "Конфигуратор",
                CompanyName = "AsuGenerator",
                KpNumber = input.ProjectNumber
            };

            ICabinetStrategy strategy = StrategyFactory.GetStrategy(selectedCabinetType);
            matchedComponents = strategy.CalculateComponents(input);
        }
        catch (Exception ex)
        {
            loadedConfig = new VentAvtomatikaConfig { ClientName = "ОШИБКА", CompanyName = ex.GetType().Name, KpNumber = ex.Message };
            matchedComponents = new();
        }
    }

    private async Task DownloadFile()
    {
        if (loadedConfig == null || matchedComponents == null || !matchedComponents.Any()) return;

        try
        {
            byte[] excelBytes = DocGen.GenerateExcelSpecification(matchedComponents, loadedConfig);
            string fileName = $"Спецификация_{loadedConfig.KpNumber}.xlsx";

            using var fileStream = new MemoryStream(excelBytes);
            using var streamRef = new DotNetStreamReference(stream: fileStream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Ошибка: {ex.Message}");
        }
    }
    private async Task DownloadEplanXml()
    {
        if (matchedComponents == null || !matchedComponents.Any()) return;

        var generator = new EplanXmlGenerator();
        byte[] xmlBytes = generator.Generate(matchedComponents, loadedConfig?.KpNumber ?? "Проект");

        string fileName = $"Спецификация_EPLAN_{loadedConfig?.KpNumber ?? "Проект"}.xml";
        using var fileStream = new MemoryStream(xmlBytes);
        using var streamRef = new DotNetStreamReference(stream: fileStream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
    @code {
        // Класс строки таблицы клемм
        public class TerminalRow
        {
            public string XBlockName { get; set; } = "XT1";
            public string TerminalType { get; set; } = "Проходная (Винт)";
            public string WireSection { get; set; } = "2.5";
            public int Quantity { get; set; } = 10;
        }

        // Список клеммных рядов в таблице
        private List<TerminalRow> TerminalRows { get; set; } = new()
    {
        new TerminalRow { XBlockName = "XT1", TerminalType = "Проходная (Винт)", WireSection = "2.5", Quantity = 24 },
        new TerminalRow { XBlockName = "XT2", TerminalType = "Заземляющая PE", WireSection = "2.5", Quantity = 4 }
    };

        private void AddTerminalRow()
        {
            // Автоматически инкрементируем индекс клеммника для удобства (XT1 -> XT2 -> XT3)
            string nextBlockName = $"XT{TerminalRows.Count + 1}";
            TerminalRows.Add(new TerminalRow { XBlockName = nextBlockName });
        }

        private void RemoveTerminalRow(TerminalRow row)
        {
            if (TerminalRows.Count > 1)
            {
                TerminalRows.Remove(row);
            }
        }
    }
