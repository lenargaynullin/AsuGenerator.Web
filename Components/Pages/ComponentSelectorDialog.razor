@using AsuGenerator.Web.Models
@using System.IO
@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject ISnackbar Snackbar
@inject AsuGenerator.Web.Services.EquipmentDatabase EquipmentDb

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
            Подбор оборудования по типу: <b>@TargetType</b>
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_searchQuery"
                      Placeholder="Быстрый фильтр по артикулу или названию..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.FilterList"
                      Class="mb-4"
                      Immediate="true" />

        <div style="max-height: 400px; overflow-y: auto;">
            <MudTable Items="@FilteredComponents()" Dense="true" Hover="true" Bordered="true" Striped="true" T="EquipmentItem" OnRowClick="@RowClick">
                <HeaderContent>
                    <MudTh>Артикул</MudTh>
                    <MudTh>Наименование / Описание</MudTh>
                    <MudTh>Поставщик</MudTh>
                    <MudTh Style="width: 80px;">Действие</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-family: monospace; font-size: 12px;"><b>@context.Article</b></MudTd>
                    <MudTd Style="font-size: 12px;">@context.Name</MudTd>
                    <MudTd Style="font-size: 11px;">@context.Vendor</MudTd>
                    <MudTd Class="text-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SelectComponent(context))">
                            Выбрать
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Отмена</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string TargetType { get; set; } = "";

    private string _searchQuery = "";
    private List<EquipmentItem> _allDbComponents = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EquipmentDb.LoadAsync(Env.WebRootPath, "terminals-base.json");
            _allDbComponents = EquipmentDb.Items;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка чтения базы оборудования: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<EquipmentItem> FilteredComponents()
    {
        var query = _allDbComponents.AsEnumerable();

        if (!string.IsNullOrEmpty(TargetType))
        {
            string groupFilter = TargetType.ToLower();
            query = query.Where(c => c.TerminalType.Contains(groupFilter, StringComparison.OrdinalIgnoreCase) ||
                                     c.Name.Contains(groupFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            query = query.Where(c => c.Article.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                     c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private void RowClick(TableRowClickEventArgs<EquipmentItem> args) => SelectComponent(args.Item);

    private void SelectComponent(EquipmentItem component)
    {
        MudDialog.Close(DialogResult.Ok(component));
    }

    private void Cancel() => MudDialog.Cancel();
}