@page "/pricing"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10 mb-10">
    <div class="text-center mb-10">
        <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true"><b>Тарифные планы asugenerator.ru</b></MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Инструменты кратного ускорения проектирования АСУ ТП для инженеров и компаний</MudText>
    </div>

    <MudGrid Justify="Justify.Center" Class="mb-10">
        @* Тариф 1: Поштучный *@
        <MudItem xs="12" md="4">
            <MudCard Outlined="true" Class="d-flex flex-column justify-space-between pa-4" Style="height: 480px;">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-1"><b>Поштучный экспорт</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Идеально для редких разовых проектов на стороне</MudText>
                    <div class="d-flex align-baseline mb-6">
                        <MudText Typo="Typo.h3"><b>1 500 ₽</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">/ за 1 проект</MudText>
                    </div>
                    <MudDivider Class="my-4" />
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" /> <MudText Typo="Typo.body2">Сборка спецификации в браузере</MudText></div>
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" /> <MudText Typo="Typo.body2">1 скачивание Excel по ГОСТ 21.110</MudText></div>
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" /> <MudText Typo="Typo.body2">Автоподбор кодов Провенто/КЭАЗ</MudText></div>
                    </div>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large" href="/configurator">Начать бесплатно</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Тариф 2: Команда (B2B) *@
        <MudItem xs="12" md="4">
            <MudCard Outlined="true" Class="d-flex flex-column justify-space-between pa-4" Style="height: 480px; border: 2px solid var(--mud-palette-primary) !important;">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-1">
                        <MudText Typo="Typo.h6" Color="Color.Primary"><b>B2B «Команда»</b></MudText>
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Label="true">Популярно</MudChip>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Для инжиниринговых компаний и щитовых производств</MudText>
                    <div class="d-flex align-baseline mb-6">
                        <MudText Typo="Typo.h3" Color="Color.Primary"><b>10 000 ₽</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">/ месяц</MudText>
                    </div>
                    <MudDivider Class="my-4" />
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" /> <MudText Typo="Typo.body2"><b>До 5 инженеров</b> в едином аккаунте</MudText></div>
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" /> <MudText Typo="Typo.body2"><b>Безлимитное</b> скачивание ГОСТ Excel</MudText></div>
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" /> <MudText Typo="Typo.body2">Брендирование штампа (ваш логотип)</MudText></div>
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" /> <MudText Typo="Typo.body2"><b>Оплата по безналичному расчету (счет/акт)</b></MudText></div>
                    </div>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="OpenInvoiceDialog">Оплатить по счету</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Блок контактов (с экранированием @@) *@
    <MudPaper Outlined="true" Class="pa-6 mud-background-gray text-center">
        <MudText Typo="Typo.h6" Class="mb-2"><b>Нужна индивидуальная база оборудования или On-Premise?</b></MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Бесплатно адаптируем шаблоны выгрузки Excel и добавим уникальные линейки ваших вендоров под стандарты вашего проектного института.</MudText>
        <div class="d-flex justify-center gap-4">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" Color="Color.Primary" href="https://t.me" Target="_blank">Написать в Telegram (@@t5522977)</MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Email" Color="Color.Primary">powerman@@mail.ru</MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private IDialogService DialogService { get; set; }

    // Метод изменен на асинхронный (async Task) под стандарты MudBlazor v7+
    private async Task OpenInvoiceDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<InvoiceRequestDialog>("Запрос счета на оплату", options);
    }
}
