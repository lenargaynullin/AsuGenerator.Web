@page "/legal/{DocumentType}"
@using MudBlazor

<PageTitle>Юридическая информация — ASU Generator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-10 mb-10">
    <MudPaper Outlined="true" Class="pa-8" Style="background-color: white;">

        @if (DocumentType?.ToLower() == "privacy")
        {
            @* ========================================== *@
            @* ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ (ФЗ-152)      *@
            @* ========================================== *@
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4"><b>Политика конфиденциальности сервиса asugenerator.ru</b></MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">Дата публикации: 16.06.2026 г.</MudText>

            <div class="d-flex flex-column gap-3" style="font-size: 14px; line-height: 1.6; color: var(--mud-palette-text-primary);">
                <p>
                    <b>1. Общие положения</b><br />
                    Настоящая Политика обработки персональных данных составлена в соответствии с требованиями Федерального закона от 27.07.2006. №152-ФЗ «О персональных данных» и определяет порядок обработки персональных данных и меры по обеспечению безопасности персональных данных, предпринимаемые Администрацией сервиса asugenerator.ru (далее — Оператор).
                </p>

                <p>
                    <b>2. Какие данные мы собираем</b><br />
                    Оператор может обрабатывать следующие персональные данные Пользователя:<br />
                    - Адрес электронной почты (Email);<br />
                    - ИНН организации (для юридических лиц);<br />
                    - Обезличенные данные о посетителях (в т.ч. файлы cookies) с помощью сервисов интернет-статистики (Яндекс Метрика и др.).
                </p>

                <p>
                    <b>3. Цели обработки данных</b><br />
                    Цель обработки персональных данных Пользователя — предоставление доступа Пользователю к сервисам, информации и/или материалам, содержащимся на веб-сайте; идентификация Пользователя в личном кабинете конфигуратора; выставление счетов на оплату для юридических лиц.
                </p>

                <p>
                    <b>4. Безопасность данных</b><br />
                    Безопасность персональных данных, обрабатываемых Оператором, обеспечивается путем реализации правовых, организационных и технических мер, необходимых для выполнения в полном объеме требований действующего законодательства в области защиты персональных данных. Все данные хранятся на серверах, физически расположенных на территории Российской Федерации.
                </p>
            </div>
        }
        else if (DocumentType?.ToLower() == "offer")
        {
            @* ========================================== *@
            @* ПУБЛИЧНАЯ ОФЕРТА С ЗАЩИТОЙ ОТ ПРЕТЕНЗИЙ     *@
            @* ========================================== *@
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4"><b>Публичная оферта (Лицензионный договор-соглашение)</b></MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">Дата публикации: 16.06.2026 г.</MudText>

            <div class="d-flex flex-column gap-3" style="font-size: 14px; line-height: 1.6; color: var(--mud-palette-text-primary);">
                <p>
                    <b>1. Предмет договора</b><br />
                    Исполнитель (Администрация asugenerator.ru) предоставляет Пользователю право использования облачного сервиса (программы для ЭВМ) на условиях простой (неисключительной) лицензии для автоматизированного составления спецификаций оборудования.
                </p>

                <p>
                    <b>2. Порядок оказания услуг и оплата</b><br />
                    Доступ к расширенному функционалу выгрузки документов в формат Excel предоставляется после оплаты Тарифа. Оплата физическими лицами производится через платежный шлюз сайта, юридическими лицами — на основании выставленного безналичного счета. Услуга считается оказанной в полном объеме в момент генерации и предоставления ссылки на скачивание файла спецификации.
                </p>

                <p>
                    <b>3. ОГРАНИЧЕНИЕ ОТВЕТСТВЕННОСТИ (Критически важный пункт для АСУ ТП)</b><br />
                    3.1. Облачный сервис asugenerator.ru является вспомогательным автоматизированным инструментом предварительного проектирования и подбора оборудования.<br />
                    3.2. <b>Финальную проверку</b> сгенерированных спецификаций, перечней элементов, заказных кодов оборудования на соответствие реальному техническому заданию (ТЗ), нормам ПУЭ, ГОСТ и требованиям промышленной безопасности <b>обязан осуществлять сам Пользователь (инженер-проектировщик)</b>.<br />
                    3.3. Разработчик и Администрация сервиса не несут ответственности за любые прямые или косвенные убытки, кассовые разрывы, штрафы или закупку некорректного оборудования, возникшие в результате ошибок, опечаток или неточностей в сгенерированных файлах документов.
                </p>

                <p>
                    <b>4. Заключительные положения</b><br />
                    Акцептом (принятием) данной оферты является факт регистрации Пользователя на сайте asugenerator.ru или нажатие кнопки «Сгенерировать эксель».
                </p>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h6" Color="Color.Error">Документ не найден</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" href="/" Class="mt-4">Вернуться на главную</MudButton>
        }

    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string DocumentType { get; set; }
}
