@page "/admin-database"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@using System.IO
@using System.Text.Json
@inject IWebHostEnvironment Env
@inject ISnackbar Snackbar

<PageTitle>Массовый импорт оборудования из Excel</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2"><b>🚀 Массовый импорт оборудования из Excel</b></MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        Скопируйте колонки из Excel (<b>Группа | Наименование | Тип, марка, артикул | Код продукции | Поставщик | Ед. изм. | Кол-во | Масса, кг | Примечание</b>), вставьте их в поле ниже и нажмите «Распознать».
    </MudText>

    <MudGrid>
        @* ПОЛЕ ВСТАВКИ ИЗ БУФЕРА ОБМЕНА *@
        <MudItem xs="12">
            <MudCard Outlined="true" Class="pa-4" Style="background-color: white;">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2"><b>1. Вставьте скопированные строки из Excel сюда (Ctrl+V):</b></MudText>

                <MudTextField T="string" @bind-Value="excelRawText" Label="Буфер обмена из Excel" Variant="Variant.Outlined" Lines="8" Placeholder="Вставьте сюда скопированные ячейки..."
                              HelperText="Порядок столбцов: Группа → Наименование → Тип/Марка/Артикул → Код → Поставщик → Ед.изм. → Кол-во → Масса → Примечание" />

                <div class="d-flex gap-3 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Analytics" OnClick="ParseExcelText">
                        Распознать строки
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@(!parsedItems.Any())" OnClick="SaveAllToDatabase">
                        Внести в базу данных (@parsedItems.Count строк)
                    </MudButton>
                </div>
            </MudCard>
        </MudItem>

        @* ПРЕДПРОСМОТР ТАБЛИЦЫ *@
        @if (parsedItems != null && parsedItems.Any())
        {
            <MudItem xs="12">
                <MudCard Outlined="true" Class="pa-4" Style="background-color: white;">
                    <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="mb-3"><b>2. Предпросмотр распознанных изделий перед импортом:</b></MudText>
                    <div style="width: 100%; overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <thead style="background-color: var(--mud-palette-background-grey); border-bottom: 2px solid var(--mud-palette-lines-default);">
                                <tr>
                                    <th style="padding: 4px; width: 100px;">Группа</th>
                                    <th style="padding: 4px;">Наименование</th>
                                    <th style="padding: 4px; width: 130px;">Тип, марка, артикул</th>
                                    <th style="padding: 4px; width: 70px;">Код</th>
                                    <th style="padding: 4px; width: 100px;">Поставщик</th>
                                    <th style="padding: 4px; width: 60px; text-align: center;">Ед.</th>
                                    <th style="padding: 4px; width: 50px; text-align: center;">Кол-во</th>
                                    <th style="padding: 4px; width: 50px; text-align: center;">Масса</th>
                                    <th style="padding: 4px; width: 80px;">Прим.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in parsedItems)
                                {
                                    <tr style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                                        <td style="padding: 4px;"><MudChip T="string" Size="Size.Small" Color="Color.Primary">@item.TerminalType</MudChip></td>
                                        <td style="padding: 4px; color: var(--mud-palette-text-secondary);">@item.Name</td>
                                        <td style="padding: 4px;"><b>@item.Article</b></td>
                                        <td style="padding: 4px; text-align: center;">—</td>
                                        <td style="padding: 4px;">@item.Vendor</td>
                                        <td style="padding: 4px; text-align: center;">@item.Unit</td>
                                        <td style="padding: 4px; text-align: center;">1</td>
                                        <td style="padding: 4px; text-align: center;">—</td>
                                        <td style="padding: 4px;">—</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private string excelRawText = "";
    private List<UniversalCalculationEngine.JsonTerminalItem> parsedItems = new();

    // АЛГОРИТМ ПАРСИНГА СТРОК (9 колонок)
    private void ParseExcelText()
    {
        if (string.IsNullOrWhiteSpace(excelRawText))
        {
            Snackbar.Add("Буфер обмена пуст! Скопируйте данные из Excel.", Severity.Warning);
            return;
        }

        try
        {
            parsedItems.Clear();

            var rows = excelRawText.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);

            // Убираем пустые строки в конце
            rows = rows.Where(r => !string.IsNullOrWhiteSpace(r)).ToArray();

            foreach (var row in rows)
            {
                // Разделяем по табуляции, СОХРАНЯЯ пустые ячейки
                var columns = row.Split('\t');

                // Если строка полностью пустая — пропускаем
                if (columns.All(c => string.IsNullOrWhiteSpace(c))) continue;

                // Безопасно читаем каждую колонку
                string groupType = columns.Length > 0 ? columns[0].Trim() : "";
                string name = columns.Length > 1 ? columns[1].Trim() : "";
                string article = columns.Length > 2 ? columns[2].Trim() : "";
                string code = columns.Length > 3 ? columns[3].Trim() : "";
                string vendor = columns.Length > 4 ? columns[4].Trim() : "";
                string unit = columns.Length > 5 ? columns[5].Trim() : "шт.";
                string quantity = columns.Length > 6 ? columns[6].Trim() : "1";
                string mass = columns.Length > 7 ? columns[7].Trim() : "";
                string note = columns.Length > 8 ? columns[8].Trim() : "";

                // Добавляем запись, если есть хотя бы наименование ИЛИ артикул
                if (!string.IsNullOrEmpty(name) || !string.IsNullOrEmpty(article))
                {
                    parsedItems.Add(new UniversalCalculationEngine.JsonTerminalItem
                    {
                        Article = string.IsNullOrEmpty(article) ? "—" : article,
                        Name = string.IsNullOrEmpty(name) ? "—" : name,
                        Unit = string.IsNullOrEmpty(unit) ? "шт." : unit,
                        Vendor = string.IsNullOrEmpty(vendor) ? "Не указан" : vendor,
                        TerminalType = string.IsNullOrEmpty(groupType) ? "Прочее" : groupType,
                        WireSection = "—"
                    });
                }
            }

            if (parsedItems.Any())
                Snackbar.Add($"Успешно распознано {parsedItems.Count} строк!", Severity.Success);
            else
                Snackbar.Add("Не удалось распознать строки. Проверьте, что данные разделены табуляцией.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка парсинга: {ex.Message}", Severity.Error);
        }
    }

    // МАССОВАЯ ЗАПИСЬ В JSON-ФАЙЛ
    private async Task SaveAllToDatabase()
    {
        if (!parsedItems.Any()) return;

        try
        {
            string path = Path.Combine(Env.WebRootPath, "Configs", "terminals-base.json");
            List<UniversalCalculationEngine.JsonTerminalItem> existingList = new();

            if (File.Exists(path))
            {
                string existingText = await File.ReadAllTextAsync(path);

                // Если файл пустой или содержит только пробелы — создаём пустой список
                if (!string.IsNullOrWhiteSpace(existingText))
                {
                    try
                    {
                        existingList = JsonSerializer.Deserialize<List<UniversalCalculationEngine.JsonTerminalItem>>(existingText) ?? new();
                    }
                    catch (JsonException)
                    {
                        // Файл повреждён или пуст — начинаем с чистого списка
                        existingList = new();
                    }
                }
            }

            existingList.AddRange(parsedItems);

            var options = new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            };
            await File.WriteAllTextAsync(path, JsonSerializer.Serialize(existingList, options));

            Snackbar.Add($"Грандиозно! Все {parsedItems.Count} позиций массово внесены в базу данных!", Severity.Success);

            excelRawText = "";
            parsedItems.Clear();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка массовой записи: {ex.Message}", Severity.Error);
        }
    }
}