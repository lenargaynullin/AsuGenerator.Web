@code {

    private CabinetType cabinetType = CabinetType.SingleSided;
    private string selectedVendor = "ОВЕН";
    private int cabinetWidth = 800;
    private int cabinetHeight = 2000; // Высота шкафа по умолчанию
    private SignalRequirement signals = new();
    private PlcComponent? selectedCpu;
    private PlcComponent busCoupler = new() { Article = "МВ210-101", Name = "Сетевой соединитель", Type = "BusCoupler", WidthMm = 42 };

    private List<PlcComponent> availableCpus = new();
    private List<PlcComponent> availableModulesInDb = new();
    private PlcCabinetCalculationResult? calcResult;
    private PlcBaseRoot _plcDbRoot = new();
    private Dictionary<string, PlcComparisonResult>? _tkpComparisonReport;

    // Второй ПЛК для сравнения
    private bool isComparisonMode = false;
    private string selectedVendor2 = "ОВЕН";
    private PlcComponent? selectedCpu2;
    private List<PlcComponent> availableCpus2 = new();

    private int TotalSignalsCount => signals.TotalDI + signals.TotalDO + signals.TotalAI + signals.TotalAO;

    protected override void OnParametersSet()
    {
        if (isComparisonMode)
        {
            UpdateAvailableCpusForComparison();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Читаем обновленный единый файл конфигурации ПЛК
            string jsonPath = Path.Combine(Env.WebRootPath, "Configs", "plc-base.json");
            if (File.Exists(jsonPath))
            {
                string jsonText = await File.ReadAllTextAsync(jsonPath);
                _plcDbRoot = System.Text.Json.JsonSerializer.Deserialize<PlcBaseRoot>(jsonText) ?? new();
            }

            // Автоматически инициализируем списки ОВЕН/REGUL
            selectedVendor = "REGUL";
            UpdateAvailableCpus();
        }
        catch (Exception ex)
        {
            // ИСПРАВЛЕНО: Валидный b2b-вызов MudBlazor Snackbar
            Snackbar.Add($"Ошибка инициализации единой базы ПЛК: {ex.Message}", Severity.Error);
        }
    }


    private void GenerateLayout()
    {
        // ЗАЩИТА 1: Если корень базы или компоненты не прочитались с диска VDS, не даем сайту упасть
        if (_plcDbRoot == null || _plcDbRoot.Components == null || !_plcDbRoot.Components.Any())
        {
            Snackbar.Add("Критическая ошибка: База данных plc-base.json пуста или не найдена на сервере!", Severity.Error);
            return;
        }

        if (selectedCpu is null)
        {
            Snackbar.Add("Выберите центральный процессор для расчета!", Severity.Warning);
            return;
        }

        try
        {
            if (selectedVendor == "ОВЕН")
            {
                calcResult = PlcCalcService.CalculateMultiPlcCabinet(
                    signals, selectedCpu, availableModulesInDb, busCoupler,
                    maxSlotsPerBasket: 12, cabinetWidthMm: cabinetWidth,
                    cabinetHeightMm: cabinetHeight, cabinetType: cabinetType
                );
            }
            else if (selectedVendor == "REGUL")
            {
                var inputSignals = new List<IoSignalRow>();
                int totalDi = signals.TotalDI;
                if (totalDi > 0) inputSignals.Add(new IoSignalRow { SignalType = "DI", TotalWithReserve = totalDi });
                if (signals.TotalDO > 0) inputSignals.Add(new IoSignalRow { SignalType = "DO", TotalWithReserve = signals.TotalDO });
                if (signals.TotalAI > 0) inputSignals.Add(new IoSignalRow { SignalType = "AI", TotalWithReserve = signals.TotalAI });
                if (signals.TotalAO > 0) inputSignals.Add(new IoSignalRow { SignalType = "AO", TotalWithReserve = signals.TotalAO });

                // Вызываем базовый расчет физических модулей ПЛК по ТЗ
                var regulRacks = RegulService.CalculateSystemWithDbAndBarriers(inputSignals);
                calcResult = new PlcCabinetCalculationResult();

                int currentCabinetIndex = 1;
                var currentCabinet = new PlcCabinet { CabinetIndex = currentCabinetIndex, Type = cabinetType, InterposingRelays = new(), Terminals = new() };
                var currentSide = cabinetType == CabinetType.SingleSided ? currentCabinet.SingleSide : currentCabinet.FrontSide;
                var currentNode = new PlcNode();

                double currentUsedHeightMm = 310.0;
                double maxUsableHeightMm = cabinetHeight - 200.0;
                int carrierCounter = 1;

                // Собираем ВСЕ модули ввода-вывода и процессоры в плоский упорядоченный список
                var allHardwareToPlace = new List<PlcComponent>();
                foreach (var rack in regulRacks)
                {
                    foreach (var item in rack.AddedComponents)
                    {
                        // Исключаем системные блоки питания шины и оконечники, их мы будем генерировать поканально для каждого ряда самостоятельно!
                        if (item.PartNumber.Contains("PP") || item.PartNumber.Contains("ST") || item.PartNumber.Contains("CH")) continue;

                        int unitWidth = item.PartNumber.Contains("CU") ? 80 : 40;
                        int unitHeight = 180;

                        for (int i = 0; i < item.Quantity; i++)
                        {
                            allHardwareToPlace.Add(new PlcComponent
                            {
                                Article = item.PartNumber,
                                Type = item.PartNumber.Contains("CU") ? "CPU" : "DI",
                                WidthMm = unitWidth,
                                HeightMm = unitHeight
                            });
                        }
                    }
                }

                // Сортируем: сначала ЦП (CPU), затем модули ввода-вывода (DI/DO), чтобы процессоры всегда были в первом крейте слева
                var hardwareQueue = new Queue<PlcComponent>(allHardwareToPlace.OrderByDescending(h => h.Type == "CPU"));

                // Запускаем цикл нарезки реек CARRIER сверху вниз
                while (hardwareQueue.Count > 0 || (carrierCounter == 1 && hardwareQueue.Count == 0))
                {
                    var currentBasket = new PlcBasket();

                    // --- 1. НАЧАЛО КРЕЙТА (СЛЕВА): Оконечник IN + 1 шт. Блок питания PP ---
                    // Модуль интерфейсный оконечный IN (40 мм, высота 130 мм)
                    currentBasket.Modules.Add(new PlcComponent { Article = "R500 ST 01 012", Type = "ST", WidthMm = 40, HeightMm = 130 });

                    // ИСПРАВЛЕНО: Ставим строго 1 шт. модуля питания шины PP в начале крейта (40 мм, высота 180 мм)
                    currentBasket.Modules.Add(new PlcComponent { Article = "R500 PP 00 021", Type = "BUS", WidthMm = 40, HeightMm = 180 });

                    // Занятая ширина системной шапкой слева: 40 (ST) + 40 (PP) = 80 мм
                    double currentBasketWidthMm = 80.0;

                    // Набиваем платы ввода-вывода/ЦП в текущий CARRIER, пока позволяет лимит 581 мм
                    while (hardwareQueue.Count > 0)
                    {
                        var nextComponent = hardwareQueue.Peek();

                        // ВАЛИДАЦИЯ ГЕОМЕТРИИ: Проверяем, влезет ли модуль в лимит 581 мм с учетом правого обязательного комплекта:
                        // 1 шт. правый БП PP (40 мм) + 1 шт. правый оконечник OUT (40 мм) = 80 мм запаса в конце рейки!
                        if (currentBasketWidthMm + nextComponent.WidthMm + 80.0 > 581.0)
                        {
                            break; // Ряд заполнен, останавливаем цикл и уходим на перенос строки
                        }

                        var component = hardwareQueue.Dequeue();
                        currentBasket.Modules.Add(component);
                        currentBasketWidthMm += component.WidthMm;
                    }

                    // --- 2. КОНЕЦ КРЕЙТА (СПРАВА): 1 шт. Блок питания PP + Оконечник OUT ---
                    // ИСПРАВЛЕНО: Переносим второй системный БП PP в самый конец крейта перед уходом кабеля вниз
                    currentBasket.Modules.Add(new PlcComponent { Article = "R500 PP 00 021", Type = "BUS", WidthMm = 40, HeightMm = 180 });

                    // Завершаем формирование крейта правым оконечником расширения шины OUT (40 мм, высота 130 мм)
                    currentBasket.Modules.Add(new PlcComponent { Article = "R500 ST 01 022", Type = "ST", WidthMm = 40, HeightMm = 130 });

                    // Добавляем 80 мм финального правого комплекта в счетчик ширины ряда
                    currentBasketWidthMm += 80.0;

                    // Проверяем лимит высоты монтажной панели шкафа Провенто (шаг требует 300 мм свободного места)
                    if (currentUsedHeightMm + 300.0 > maxUsableHeightMm)
                    {
                        currentSide.Nodes.Add(currentNode);
                        calcResult.Cabinets.Add(currentCabinet);

                        currentCabinetIndex++;
                        currentCabinet = new PlcCabinet { CabinetIndex = currentCabinetIndex, Type = cabinetType, InterposingRelays = new(), Terminals = new() };
                        currentSide = cabinetType == CabinetType.SingleSided ? currentCabinet.SingleSide : currentCabinet.FrontSide;
                        currentNode = new PlcNode();

                        currentUsedHeightMm = 310.0; // Сброс высоты для нового шкафа
                    }

                    currentNode.Baskets.Add(currentBasket);
                    currentUsedHeightMm += 300.0;
                    carrierCounter++;

                    // Защита от бесконечного цикла, если очередь пуста, но первый дефолтный ряд мы обязаны отрисовать
                    if (hardwareQueue.Count == 0) break;
                }

                currentSide.Nodes.Add(currentNode);
                calcResult.Cabinets.Add(currentCabinet);

                // Вызываем ТКП-расчет сравнения вариантов для вывода аналитики
                if (inputSignals.Any())
                {
                    _tkpComparisonReport = ComparisonEngine.CompareSystems(inputSignals, cabinetWidth, _plcDbRoot);
                }

                this.StateHasChanged();
            }




            // Принудительно обновляем UI
            this.StateHasChanged();
        }
        catch (Exception ex)
        {
            // ИСПРАВЛЕНО: Ловим абсолютно любые ошибки рантайма, выдавая инфо в Snackbar вместо падения всего сайта
            Snackbar.Add($"Ошибка генерации корзины: {ex.Message}", Severity.Error);
            calcResult = null;
        }
    }

    private void ToggleComparisonMode()
    {
        isComparisonMode = !isComparisonMode;

        if (isComparisonMode)
        {
            // По умолчанию второй вендор — ОВЕН (или другой, не совпадающий с первым)
            selectedVendor2 = selectedVendor == "REGUL" ? "ОВЕН" : "REGUL";
            UpdateAvailableCpusForComparison();
        }

        StateHasChanged();
    }

    private void UpdateAvailableCpusForComparison()
    {
        if (_plcDbRoot?.Components == null) return;

        availableCpus2 = _plcDbRoot.Components
                .Where(c => c.Vendor == selectedVendor2 && c.Category == "cpu")
                .Select(c => new PlcComponent
                {
                    Article = c.PartNumber,
                    Name = c.Description,
                    Type = "CPU",
                    WidthMm = (int)c.WidthMm
                }).ToList();

        selectedCpu2 = availableCpus2.FirstOrDefault();
        StateHasChanged();
    }

    // Обработчик смены второго вендора
    private void OnSecondVendorChanged(string vendor)
    {
        selectedVendor2 = vendor;
        UpdateAvailableCpusForComparison();
    }


    // Метод сквозного расчета уникальных позиционных обозначений (ГОСТ) в рамках Шкафа
    private string GetUniqueModuleDesignation(PlcComponent currentMod, PlcCabinet currentCabinet)
    {
        var shortName = currentMod.Type switch
        {
            "CPU" => "CPU",
            "DI" => "DI",
            "DO" => "DO",
            "AI_Current" => "AI",
            "AI_Temp" => "AI",
            "AO" => "AO",
            _ => currentMod.Type
        };

        if (currentMod.Type == "CPU") return $"{shortName}1";

        int globalTypeCounter = 0;

        // ИСПРАВЛЕНО: Выбираем нужную сторону шкафа для сквозного подсчета в зависимости от его типа
        var activeSide = currentCabinet.Type == CabinetType.SingleSided
            ? currentCabinet.SingleSide
            : currentCabinet.FrontSide;

        foreach (var node in activeSide.Nodes)
        {
            foreach (var basket in node.Baskets)
            {
                foreach (var m in basket.Modules)
                {
                    bool isSameGroup = m.Type == currentMod.Type ||
                                      (m.Type.StartsWith("AI_") && currentMod.Type.StartsWith("AI_"));

                    if (isSameGroup)
                    {
                        globalTypeCounter++;
                        if (ReferenceEquals(m, currentMod))
                        {
                            return $"{shortName}{globalTypeCounter}";
                        }
                    }
                }
            }
        }

        return shortName;
    }

    private string GetModuleChannelsText(PlcComponent mod)
    {
        int channels = mod.Type switch
        {
            "CPU" => mod.DiChannels > 0 ? mod.DiChannels : mod.AiChannels,
            "DI" => mod.DiChannels,
            "DO" => mod.DoChannels,
            "AI_Current" => mod.AiChannels,
            "AI_Temp" => mod.AiChannels,
            "AO" => mod.AoChannels,
            _ => 0
        };
        return $"{channels} channel";
    }

    private string GetModuleColorClass(string type) => type switch
    {
        // ИСПРАВЛЕНО: Если выбран REGUL, красим процессоры и модули в изумрудный, блоки питания в темно-серый
        "CPU" => selectedVendor == "REGUL" ? "mud-theme-success" : "bg-cpu",
        "BUS" => selectedVendor == "REGUL" ? "mud-theme-dark" : "bg-power",
        "DI" => selectedVendor == "REGUL" ? "mud-theme-success" : "bg-di",
        "DO" => selectedVendor == "REGUL" ? "mud-theme-success" : "bg-do",
        "AI_Current" => selectedVendor == "REGUL" ? "mud-theme-success" : "bg-ai-cur",
        "BARRIER_BLOCK" => "mud-theme-warning", // Желтый цвет взрывозащиты Exi
        _ => "mud-theme-secondary"
    };

    private void UpdateAvailableCpus()
    {
        // Защита: если корень базы или компоненты не инициализированы, выходим из метода
        if (_plcDbRoot?.Components == null) return;

        // Динамический фильтр контроллеров из plc-base.json по выбранному бренду
        var vendorData = _plcDbRoot.Vendors?.FirstOrDefault(v => v.Name == selectedVendor);
        if (vendorData != null)
        {
            // Преобразуем данные из DTO в формат вашего PlcComponent
            availableCpus = _plcDbRoot.Components
                .Where(c => c.Vendor == selectedVendor && c.Category == "cpu")
                .Select(c => new PlcComponent
                {
                    Article = c.PartNumber,
                    Name = c.Description,
                    Type = "CPU",
                    WidthMm = (int)c.WidthMm
                }).ToList();

            selectedCpu = availableCpus.FirstOrDefault();
        }

        StateHasChanged(); // Принудительно обновляем UI MudBlazor
    }
    private async Task SavePlcProjectToDashboard()
    {
        try
        {
            // 1. Формируем пути к базе проектов дашборда
            //string configDir = Path.Combine(Env.WebRootPath, "Configs");
            //string configPath = Path.Combine(configDir, "cabinet-templates.json");
            var configDir = Path.Combine(AppContext.BaseDirectory, "wwwroot", "Configs");
            var configPath = Path.Combine(configDir, "cabinet-templates.json");

            if (!Directory.Exists(configDir)) Directory.CreateDirectory(configDir);
            if (!File.Exists(configPath)) await File.WriteAllTextAsync(configPath, "[]");

            // Читаем текущие проекты дашборда
            string jsonText = await File.ReadAllTextAsync(configPath);
            var templates = System.Text.Json.JsonSerializer.Deserialize<List<CabinetSpecificationTemplate>>(jsonText) ?? new();

            // 2. Генерируем сложный b2b-шифр проекта для щитовиков
            string projectCipher = $"{DateTime.Now.Year}-{DateTime.Now.Month:D2}-АСУ.{selectedVendor}.{selectedCpu?.Article}";

            // Защита от дубликатов имен
            if (templates.Any(t => t.TemplateName.Equals(projectCipher, StringComparison.OrdinalIgnoreCase)))
            {
                projectCipher += $"_{Guid.NewGuid().ToString().Substring(0, 4).ToUpper()}";
            }

            var savedItems = new List<CustomTemplateItem>();

            // 3. Собираем все модули ПЛК из графических корзин рендера в плоскую спецификацию ГОСТ
            var visualCabinet = calcResult.Cabinets.FirstOrDefault();
            if (visualCabinet != null)
            {
                var visualSide = cabinetType == CabinetType.SingleSided ? visualCabinet.SingleSide : visualCabinet.FrontSide;
                var allModules = visualSide.Nodes.SelectMany(n => n.Baskets).SelectMany(b => b.Modules);

                // Группируем одинаковые модули (артикулы REGUL) для ГОСТ-строки
                var groupedModules = allModules.GroupBy(m => m.Article);
                foreach (var group in groupedModules)
                {
                    string categoryName = group.First().Type switch
                    {
                        "CPU" => "Центральный процессор",
                        "BUS" => "Модуль питания шины",
                        "BARRIER_BLOCK" => "Взрывозащита Exi",
                        _ => "Модуль ввода/вывода"
                    };

                    savedItems.Add(new CustomTemplateItem
                    {
                        PartNumber = group.Key,
                        Name = $"{categoryName} {selectedVendor} R500",
                        Quantity = group.Count(),
                        Unit = "шт",
                        Type = group.First().Type == "BARRIER_BLOCK" ? "выключатель автоматический" : "корпус" // Маппинг категорий стоимости для дашборда
                    });

                    // Под каждый физический модуль РЕГУЛ (кроме барьеров) добавляем пластиковое шасси
                    if (group.First().Type != "BARRIER_BLOCK")
                    {
                        string chassisArt = group.Key.Contains("CU") || group.Key.Contains("PP") ? "R500 CH 02 022" : "R500 CH 01 011";
                        savedItems.Add(new CustomTemplateItem
                        {
                            PartNumber = chassisArt,
                            Name = $"Модуль монтажного шасси под {group.Key}",
                            Quantity = group.Count(),
                            Unit = "шт",
                            Type = "шина"
                        });
                    }
                }
            }

            // 4. Создаем итоговый объект b2b-проекта
            var newProject = new CabinetSpecificationTemplate
            {
                Id = Guid.NewGuid().ToString(),
                TemplateName = projectCipher,
                CabinetName = $"Шкаф управления на базе {selectedVendor} R500",
                ObjectLocation = $"Объект: Система РСУ/ПАЗ ({signals.TotalDI} DI, {signals.TotalDO} DO)",
                LastModified = DateTime.Now,
                Items = savedItems
            };

            // Сохраняем обратно на диск VDS reg.ru
            templates.Add(newProject);
            // ИСПРАВЛЕНО: Добавляем JavaScriptEncoder.Create, чтобы кириллица в JSON оставалась русской
            var serializeOptions = new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All)
            };

            var updatedJson = System.Text.Json.JsonSerializer.Serialize(templates, serializeOptions);
            await File.WriteAllTextAsync(configPath, updatedJson);

            Snackbar.Add($"Спецификация шкафа ПЛК сохранена под шифром {projectCipher}!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка экспорта в проекты: {ex.Message}", Severity.Error);
        }
    }
    private void NavigateToComparison()
    {
        // Суммируем сигналы из новой модели
        int totalDi = signals.TotalDI;
        int totalDo = signals.TotalDO;
        int totalAi = signals.TotalAI;
        int totalAo = signals.TotalAO;

        // Формируем b2b URL-ссылку с параметрами
        string url = $"/plc-comparison?di={totalDi}&do={totalDo}&ai={totalAi}&ao={totalAo}&width={cabinetWidth}";
        // Если режим сравнения активен — добавляем второго вендора
        if (isComparisonMode && selectedCpu2 != null)
        {
            url += $"&vendor1={selectedVendor}&vendor2={selectedVendor2}";
        }

        JS.InvokeVoidAsync("open", url, "_blank");
    }


