@page "/plc-configurator"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@using System.Text.Json

@inject PlcCalculationService PlcCalcService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AsuGenerator.Web.Services.RegulCalculationService RegulService
@inject MudBlazor.ISnackbar Snackbar
@inject AsuGenerator.Web.Services.PlcComparisonEngine ComparisonEngine
@inject IJSRuntime JS


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-4">
    <MudText Typo="Typo.h5" Class="mb-3 font-weight-bold" Style="font-size: 16px;">⚙️ Расширенная конфигурация ПЛК и сигналов</MudText>

    <MudGrid Spacing="2">
        <!-- ВВОД СИГНАЛОВ (ЛЕВАЯ КОЛОНКА) -->
        <MudItem xs="12" md="5">
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent Class="pa-2">
                    <MudGrid Dense="true" Spacing="1">
                        <MudItem xs="4">
                            <MudSelect T="string" Label="Производитель" @bind-Value="selectedVendor" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;">
                                <MudSelectItem Value="@("REGUL")">REGUL</MudSelectItem>
                                <MudSelectItem Value="@("ОВЕН")">ОВЕН</MudSelectItem>
                                <MudSelectItem Value="@("АБАК")">АБАК</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSelect T="PlcComponent" Label="Контроллер (CPU)" @bind-Value="selectedCpu" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;">
                                @foreach (var cpu in availableCpus)
                                {
                                    <MudSelectItem Value="@cpu">@cpu.Article</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="cabinetWidth" Label="Ширина (мм)" Min="600" Max="1200" Step="100" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px; font-weight: bold;" />
                        </MudItem>


                        <!-- ДОБАВЛЕНО: СЕЛЕКТОР ТИПА ШКАФА СТРОГО С ЗАКРЫТЫМИ ТЕГАМИ MUDITEM -->
                        <MudItem xs="12" Class="mt-1 border-top pt-2">
                            <MudText Typo="Typo.caption" Class="font-weight-bold grey-text d-block mb-1" Style="font-size: 10px;">КОНСТРУКТИВ МОНТАЖНОЙ ПАНЕЛИ:</MudText>
                            <MudRadioGroup T="CabinetType" @bind-Value="cabinetType" Color="Color.Primary" Dense="true">
                                <MudRadio Value="CabinetType.SingleSided" Size="Size.Small">
                                    <span style="font-size: 11px; font-weight: bold;">Односторонний (Общая панель)</span>
                                </MudRadio>
                                <MudRadio Value="CabinetType.DoubleSided" Size="Size.Small" Class="ml-2">
                                    <span style="font-size: 11px; font-weight: bold;">Двухсторонний (Лицевая/Задняя)</span>
                                </MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
                @* Кнопка включения режима сравнения *@
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Size="Size.Small"
                           FullWidth="true"
                           OnClick="ToggleComparisonMode"
                           Class="mt-2"
                           StartIcon="@Icons.Material.Filled.CompareArrows"
                           Style="font-size: 11px; height: 32px;">
                    @(isComparisonMode ? "Скрыть сравнение" : "Сравнить с другим ПЛК")
                </MudButton>
                @* Блок выбора второго ПЛК — показывается только в режиме сравнения *@
                @if (isComparisonMode)
                {
                    <MudCard Elevation="2" Class="mt-3 pa-2" Style="border-left: 4px solid #e67e22; background-color: #1e293b;">
                        <MudText Typo="Typo.caption" Class="font-weight-bold mb-2" Style="color: #e67e22;">
                            ⚡ ВАРИАНТ ДЛЯ СРАВНЕНИЯ
                        </MudText>
                        <MudGrid Dense="true" Spacing="1">
                            <MudItem xs="6">
                                <MudSelect T="string" Label="Производитель 2"
                                           @bind-Value="selectedVendor2"
                                           Variant="Variant.Outlined" Dense="true"
                                           Margin="Margin.Dense" Style="font-size: 11px; color: white;">
                                    <MudSelectItem Value="@("ОВЕН")">ОВЕН</MudSelectItem>
                                    <MudSelectItem Value="@("REGUL")">REGUL</MudSelectItem>
                                    <MudSelectItem Value="@("АБАК")">АБАК К3</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect T="PlcComponent" Label="Контроллер 2 (CPU)"
                                           @bind-Value="selectedCpu2"
                                           Variant="Variant.Outlined" Dense="true"
                                           Margin="Margin.Dense" Style="font-size: 11px; color: white;">
                                    @foreach (var cpu in availableCpus2)
                                    {
                                        <MudSelectItem Value="@cpu">@cpu.Article</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                }
            </MudCard>

            <!-- ОТКРЫТЫЙ СПИСОК СИГНАЛОВ -->
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent Class="pa-3">
                    <div class="d-flex justify-space-between align-center mb-2 border-bottom pb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 11px; color: #2c3e50;">ТЕКУЩИЙ СЧЕТЧИК СИГНАЛОВ ПОЛЯ:</MudText>
                        <MudChip T="string" Color="@(TotalSignalsCount > 1000 ? Color.Warning : Color.Default)" Size="Size.Small" Style="font-size: 10px; height: 18px;"><b>@TotalSignalsCount / 1000 на 1 ПЛК</b></MudChip>
                    </div>

                    <!-- ========== АНАЛОГОВЫЕ ВХОДЫ (AI) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #8e44ad;">АНАЛОГОВЫЕ ВХОДЫ (AI)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiNisCurrent2W" Label="AI-NIS (4-20 mA, 2 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiNisCurrent4W" Label="AI-NIS (4-20 mA, 4 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiRtdNis3W" Label="AI-RTD-NIS (3 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiNisPl3W" Label="AI-NIS (Pl, 3 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== ИСКРОБЕЗОПАСНЫЕ АНАЛОГОВЫЕ ВХОДЫ (AI-IS) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #e67e22;">ИСКРОБЕЗОПАСНЫЕ АНАЛОГОВЫЕ ВХОДЫ (AI-IS)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiIsCurrent2W" Label="AI-IS (4-20 mA, 2 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiIsCurrent4W" Label="AI-IS (4-20 mA, 4 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiIsPl3W" Label="AI-IS (Pl, 3 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== РЕЗЕРВИРОВАННЫЕ АНАЛОГОВЫЕ ВХОДЫ (AI-R) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #c0392b;">РЕЗЕРВИРОВАННЫЕ АНАЛОГОВЫЕ ВХОДЫ (AI-R)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiRNisCurrent2W" Label="AI-R-NIS (4-20 mA, 2 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiRNisCurrent4W" Label="AI-R-NIS (4-20 mA, 4 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiRIsCurrent2W" Label="AI-R-IS (4-20 mA, 2 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AiRIsCurrent4W" Label="AI-R-IS (4-20 mA, 4 w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== АНАЛОГОВЫЕ ВЫХОДЫ (AO) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #16a085;">АНАЛОГОВЫЕ ВЫХОДЫ (AO)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">

                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoNisCurrent" Label="AO-NIS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoNisVoltage" Label="AO-NIS (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoIsCurrent" Label="AO-IS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoIsVoltage" Label="AO-IS (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== РЕЗЕРВИРОВАННЫЕ АНАЛОГОВЫЕ ВЫХОДЫ (AO-R) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #c0392b;">РЕЗЕРВИРОВАННЫЕ АНАЛОГОВЫЕ ВЫХОДЫ (AO-R)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoRIsCurrent" Label="AO-R-IS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoRNisCurrent" Label="AO-R-NIS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== ДИСКРЕТНЫЕ ВХОДЫ (DI) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #2980b9;">ДИСКРЕТНЫЕ ВХОДЫ (DI)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiIsNamur" Label="DI-IS (NAMUR)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiNisDryContact" Label="DI-NIS с.к." Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiNis24VDC" Label="DI-NIS (=24VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiNisVfg" Label="DI-NIS (VFG)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiNisMcc230VAC" Label="DI-NIS (MCC 230VAC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DiNisMcc220VDC" Label="DI-NIS (MCC 220VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- ========== ДИСКРЕТНЫЕ ВЫХОДЫ (DO) ========== -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #d35400;">ДИСКРЕТНЫЕ ВЫХОДЫ (DO)</MudText>
                    <MudGrid Dense="true" Spacing="1">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoNisVfcNO" Label="DO-NIS (VFC NO)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoNis24VDC" Label="DO-NIS (24VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoNisMcc230VAC" Label="DO-NIS (MCC 230VAC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoNisMcc220VDC" Label="DO-NIS (MCC 220VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                    </MudGrid>

                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1" Class="mb-3 pa-2">
                <div class="d-flex justify-space-between align-center mb-1">
                    <MudText Typo="Typo.caption" Style="font-size: 11px;">Резерв каналов по ГОСТ:</MudText>
                    <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 11px;">@signals.ReservePercent%</MudText>
                </div>
                <MudSlider @bind-Value="signals.ReservePercent" Min="0" Max="40" Step="5" Color="Color.Primary" Class="ma-0 py-1" />
            </MudCard>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" OnClick="GenerateLayout" Disabled="@(selectedCpu is null)" Style="font-size: 11px; height: 32px;">
                Сгенерировать корзины
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       FullWidth="true"
                       Class="mt-2 py-2"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       OnClick="NavigateToComparison">
                Сравнить варианты (ТКП)
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       FullWidth="true"
                       Class="mt-4 py-2"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SavePlcProjectToDashboard"
                       Disabled="@(calcResult == null || !calcResult.Cabinets.Any())">
                Сохранить спецификацию ПЛК в проекты
            </MudButton>
        </MudItem>

                <!-- ВЫВОД РЕЗУЛЬТАТОВ (ПРАВАЯ КОЛОНКА) -->
        <MudItem xs="12" md="7">
            <MudCard Elevation="1" Style="min-height: 520px;">
                <MudCardHeader Class="py-1 px-3 border-bottom">
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle2" Style="font-size: 13px; font-weight: bold;">📐 Компоновка шкафов автоматизации</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-2">
                    @if (calcResult is null || !calcResult.Cabinets.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center font-italic text-muted mt-12" style="font-size: 11px;">
                            <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Medium" Class="mb-1" />
                            <MudText Style="font-size: 11px;">Задайте конфигурацию сигналов слева и нажмите кнопку генерации</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var cabinet in calcResult.Cabinets)
                        {
                            <MudPaper Elevation="4" Class="pa-4 mb-6" Style="background-color: #0f172a; border: 2px solid #334155;">
                                <MudText Typo="Typo.subtitle1" Style="color: #3cb890;" Class="mb-3">
                                    <b>МОНТАЖНАЯ ПАНЕЛЬ ШКАФА №@cabinet.CabinetIndex (Провенто @(cabinetWidth)х@(cabinetHeight)х400 мм)</b>
                                </MudText>

                                @* КОРНЕВОЙ КОНТЕЙНЕР ШКАФА (Ширина 100%) *@
                                <div class="enclosure-panel" style="width: 100%; border: 3px solid #64748b; background-color: #111827; padding: 0; display: flex; flex-direction: row; position: relative;">

                                    @* --- 1. ЛЕВЫЙ ВЕРТИКАЛЬНЫЙ КОРОБ 40 мм (~230В) --- *@
                                    <div class="vertical-duct-left text-center" style="width: 32px; min-width: 32px; background-color: #334155; color: #94a3b8; font-family: monospace; font-size: 9px; display: flex; align-items: center; justify-content: center; border-right: 1px solid #475569; writing-mode: vertical-lr; transform: rotate(180deg); padding: 10px 0;">
                                        ВЕРТИКАЛЬНЫЙ КОРОБ 40х100 СЕРЫЙ (~230В)
                                    </div>

                                    @* --- ЦЕНТРАЛЬНАЯ РАБОЧАЯ ЗОНА МОНТАЖНОЙ ПАНЕЛИ --- *@
                                    @* ИСПРАВЛЕНО: Задаем центральной зоне фиксированную ширину 581px (масштаб 1:1 к рейке), чтобы правый короб встал вплотную *@
                                    <div class="main-panel-content" style="width: 510px; min-width: 510px; max-width: 510px; display: flex; flex-direction: column; overflow: hidden;">


                                        @* ВЕРХНИЙ СИЛОВОЙ ОТСЕК ШКАФА *@
                                        <div class="cable-duct-top" style="height: 32px; background-color: #334155; color: #94a3b8; font-family: monospace; font-size: 10px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #475569;">
                                            ГОРИЗОНТАЛЬНЫЙ КОРОБ 40х100 СЕРЫЙ (~230В)
                                        </div>

                                        <div class="power-supply-zone d-flex align-end justify-start px-4" style="height: 152px; background-color: rgba(255,255,255,0.02); border-bottom: 1px solid #334155; padding-bottom: 6px;">
                                            <div class="d-flex gap-2">
                                                <div class="text-center rounded text-white pa-1" style="width: 55px; height: 130px; background-color: #1e293b; border: 2px solid #3cb890; font-size: 9px; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; padding: 4px 0;">
                                                    <span class="font-weight-bold" style="color: #3cb890;">=24 В</span>
                                                    <span style="font-family: monospace; font-size: 8px; font-weight: bold; writing-mode: vertical-lr; transform: rotate(180deg); margin: 0 auto;">БП 220/24 В</span>
                                                    <span style="font-size: 7px; opacity: 0.6;">10 А</span>
                                                </div>
                                                <div class="text-center rounded text-white pa-1" style="width: 55px; height: 130px; background-color: #1e293b; border: 2px solid #3cb890; font-size: 9px; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; padding: 4px 0;">
                                                    <span class="font-weight-bold" style="color: #3cb890;">=24 В</span>
                                                    <span style="font-family: monospace; font-size: 8px; font-weight: bold; writing-mode: vertical-lr; transform: rotate(180deg); margin: 0 auto;">БП 220/24 В</span>
                                                    <span style="font-size: 7px; opacity: 0.6;">10 А</span>
                                                </div>
                                            </div>
                                            <MudText Typo="Typo.caption" Style="color: #475569; margin-left: 20px; font-family: monospace; font-weight: bold; letter-spacing: 0.5px;">
                                                ПРОСТРАНСТВО ВЫСОТОЙ 190 ММ ДЛЯ БЛОКОВ ПИТАНИЯ ШКАФА
                                            </MudText>
                                        </div>

