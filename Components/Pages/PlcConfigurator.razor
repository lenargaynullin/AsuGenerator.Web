@code {
    private List<string>? diagLog;
    private CabinetType cabinetType = CabinetType.SingleSided;
    private string selectedVendor = "АБАК";
    private int cabinetWidth = 800;
    private int cabinetHeight = 2000; // Высота шкафа по умолчанию
    private SignalRequirement signals = new();
    private PlcComponent? selectedCpu;
    private PlcComponent busCoupler = new() { Article = "МВ210-101", Name = "Сетевой соединитель", Type = "BusCoupler", WidthMm = 42 };

    private List<PlcComponent> availableCpus = new();
    private List<PlcComponent> availableModulesInDb = new();
    private PlcCabinetCalculationResult? calcResult;
    private PlcBaseRoot _plcDbRoot = new();
    private Dictionary<string, PlcComparisonResult>? _tkpComparisonReport;

    // Второй ПЛК для сравнения
    private bool isComparisonMode = false;
    private string selectedVendor2 = "ОВЕН";
    private PlcComponent? selectedCpu2;
    private List<PlcComponent> availableCpus2 = new();

    private int TotalSignalsCount => signals.TotalDI + signals.TotalDO + signals.TotalAI + signals.TotalAO;

    protected override void OnParametersSet()
    {
        if (isComparisonMode)
        {
            UpdateAvailableCpusForComparison();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Читаем обновленный единый файл конфигурации ПЛК
            string jsonPath = Path.Combine(Env.WebRootPath, "Configs", "plc-base.json");
            if (File.Exists(jsonPath))
            {
                string jsonText = await File.ReadAllTextAsync(jsonPath);
                _plcDbRoot = System.Text.Json.JsonSerializer.Deserialize<PlcBaseRoot>(jsonText) ?? new();
            }

            // Автоматически инициализируем списки ОВЕН/REGUL
            selectedVendor = "REGUL";
            UpdateAvailableCpus();
            this.StateHasChanged();
        }
        catch (Exception ex)
        {
            // ИСПРАВЛЕНО: Валидный b2b-вызов MudBlazor Snackbar
            Snackbar.Add($"Ошибка инициализации единой базы ПЛК: {ex.Message}", Severity.Error);
        }
    }


    private void GenerateLayout()
    {
        if (_plcDbRoot == null || _plcDbRoot.Components == null || !_plcDbRoot.Components.Any())
        {
            Snackbar.Add("Критическая ошибка: База данных plc-base.json пуста или не найдена на сервере!", Severity.Error);
            return;
        }

        try
        {
            // Используем UniversalCalculationService для любого вендора
            var (result, log, pickedModules) = UniversalService.CalculateSystemWithDiagnostics(selectedVendor, signals, cabinetWidth);
            diagLog = log;

            // Показываем количество найденных/ненайденных сигналов
            int found = diagLog.Count(l => l.StartsWith("✅"));
            int notFound = diagLog.Count(l => l.StartsWith("❌"));
            int warnings = diagLog.Count(l => l.StartsWith("⚠️"));
            Snackbar.Add($"Подобрано: {found} типов сигналов. Не найдено: {notFound}. Предупреждений: {warnings}.", Severity.Info);

            // Принудительно показываем лог
            StateHasChanged();

            // Формируем визуальный результат в старом формате calcResult
            calcResult = new PlcCabinetCalculationResult();
            var cabinet = new PlcCabinet
            {
                CabinetIndex = 1,
                Type = cabinetType,
                InterposingRelays = new(),
                Terminals = new()
            };

            var side = cabinetType == CabinetType.SingleSided ? cabinet.SingleSide : cabinet.FrontSide;
            var node = new PlcNode();
            var basket = new PlcBasket();

            // Добавляем CPU
            var cpu = _plcDbRoot.Components.FirstOrDefault(c =>
                c.Vendor != null &&
                c.Vendor.Equals(selectedVendor, StringComparison.OrdinalIgnoreCase) &&
                c.Category != null &&
                c.Category.Equals("cpu", StringComparison.OrdinalIgnoreCase));
            if (cpu != null)
            {
                basket.Modules.Add(new PlcComponent
                {
                    Article = cpu.PartNumber,
                    Type = "CPU",
                    WidthMm = (int)cpu.WidthMm,
                    HeightMm = (int)cpu.HeightMm
                });
            }

            // Добавляем модули из результатов UniversalCalculationService
            const int MaxModulesPerBasket = 40;
            const int MaxWidthPerBasket = 581;
            int currentBasketWidth = basket.Modules.Sum(m => m.WidthMm);

            foreach (var picked in pickedModules)
            {
                for (int i = 0; i < picked.ModulesNeeded; i++)
                {
                    // Проверяем, нужно ли создать новую корзину
                    if (basket.Modules.Count >= MaxModulesPerBasket ||
                        currentBasketWidth + picked.WidthMm > MaxWidthPerBasket)
                    {
                        node.Baskets.Add(basket);
                        basket = new PlcBasket();
                        currentBasketWidth = 0;
                    }

                    basket.Modules.Add(new PlcComponent
                    {
                        Article = picked.PartNumber,
                        Type = picked.Category.ToUpper(),
                        WidthMm = (int)picked.WidthMm,
                        HeightMm = 125
                    });

                    currentBasketWidth += (int)picked.WidthMm;
                }
            }

            node.Baskets.Add(basket);
            side.Nodes.Add(node);
            calcResult.Cabinets.Add(cabinet);

            // Запускаем сравнение для ТКП
            _tkpComparisonReport = ComparisonEngine.CompareSystems(signals, cabinetWidth, _plcDbRoot);

            Snackbar.Add($"Система {result.VendorName} рассчитана: {result.TotalRacksCount} крейтов, {result.TotalCabinetsCount} шкафов, {result.TotalHardwareCostRub:N0} ₽", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка расчёта: {ex.Message}", Severity.Error);
            calcResult = null;
        }
    }


    private void ToggleComparisonMode()
    {
        isComparisonMode = !isComparisonMode;

        if (isComparisonMode)
        {
            // По умолчанию второй вендор — ОВЕН (или другой, не совпадающий с первым)
            selectedVendor2 = selectedVendor == "REGUL" ? "АБАК" : "REGUL";
            UpdateAvailableCpusForComparison();
        }

        StateHasChanged();
    }

    private void UpdateAvailableCpus()
    {
        if (_plcDbRoot?.Components == null) return;

        availableCpus = _plcDbRoot.Components
            .Where(c => c.Category != null &&
                        c.Category.Equals("cpu", StringComparison.OrdinalIgnoreCase) &&
                        c.Vendor != null &&
                        c.Vendor.Equals(selectedVendor, StringComparison.OrdinalIgnoreCase))
            .Select(c => new PlcComponent
            {
                Article = c.PartNumber,
                Name = c.Description,
                Type = "cpu",
                WidthMm = (int)c.WidthMm
            }).ToList();

        if (!availableCpus.Any())
        {
            availableCpus.Add(new PlcComponent
            {
                Article = $"{selectedVendor}-CPU-UNKNOWN",
                Name = $"Процессор {selectedVendor} (нет в базе)",
                Type = "cpu",
                WidthMm = 80
            });
        }

        selectedCpu = availableCpus.FirstOrDefault();
        StateHasChanged();
    }

