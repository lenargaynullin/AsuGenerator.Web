                                                <div style="height: 32px; background-color: rgba(60, 184, 144, 0.03); display: flex; align-items: center; padding-left: 10px;">
                                                    <span style="font-size: 8px; color: #475569; font-family: monospace;">ОТСТУП 40 ММ ВНИЗ</span>
