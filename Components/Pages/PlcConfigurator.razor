                                                             style="min-width: @(m.WidthMm * 0.8)px; max-width: @(m.WidthMm * 0.8)px; height: @(m.HeightMm * 0.8)px; margin: 0 1.5px; overflow: hidden; display: inline-flex; flex-direction: column; justify-content: space-between; padding: 6px 0; vertical-align: bottom; box-sizing: border-box;">

