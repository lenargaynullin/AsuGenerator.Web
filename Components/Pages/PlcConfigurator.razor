@page "/plc-configurator"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@using System.Text.Json

@inject PlcCalculationService PlcCalcService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AsuGenerator.Web.Services.RegulCalculationService RegulService
@inject MudBlazor.ISnackbar Snackbar
@inject AsuGenerator.Web.Services.PlcComparisonEngine ComparisonEngine


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-4">
    <MudText Typo="Typo.h5" Class="mb-3 font-weight-bold" Style="font-size: 16px;">⚙️ Расширенная конфигурация ПЛК и сигналов</MudText>

    <MudGrid Spacing="2">
        <!-- ВВОД СИГНАЛОВ (ЛЕВАЯ КОЛОНКА) -->
        <MudItem xs="12" md="5">
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent Class="pa-2">
                    <MudGrid Dense="true" Spacing="1">
                        <MudItem xs="4">
                            <MudSelect T="string" Label="Производитель" @bind-Value="selectedVendor" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;">
                                <MudSelectItem Value="@("ОВЕН")">ОВЕН</MudSelectItem>
                                <MudSelectItem Value="@("REGUL")">REGUL</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="4">
                            <MudSelect T="PlcComponent" Label="Контроллер (CPU)" @bind-Value="selectedCpu" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;">
                                @foreach (var cpu in availableCpus.Where(c => c.Name.Contains(selectedVendor)))
                                {
                                    <MudSelectItem Value="@cpu">@cpu.Article</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="cabinetWidth" Label="Ширина (мм)" Min="600" Max="1200" Step="100" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px; font-weight: bold;" />
                        </MudItem>


                        <!-- ДОБАВЛЕНО: СЕЛЕКТОР ТИПА ШКАФА СТРОГО С ЗАКРЫТЫМИ ТЕГАМИ MUDITEM -->
                        <MudItem xs="12" Class="mt-1 border-top pt-2">
                            <MudText Typo="Typo.caption" Class="font-weight-bold grey-text d-block mb-1" Style="font-size: 10px;">КОНСТРУКТИВ МОНТАЖНОЙ ПАНЕЛИ:</MudText>
                            <MudRadioGroup T="CabinetType" @bind-Value="cabinetType" Color="Color.Primary" Dense="true">
                                <MudRadio Value="CabinetType.SingleSided" Size="Size.Small">
                                    <span style="font-size: 11px; font-weight: bold;">Односторонний (Общая панель)</span>
                                </MudRadio>
                                <MudRadio Value="CabinetType.DoubleSided" Size="Size.Small" Class="ml-2">
                                    <span style="font-size: 11px; font-weight: bold;">Двухсторонний (Лицевая/Задняя)</span>
                                </MudRadio>
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- ОТКРЫТЫЙ СПИСОК СИГНАЛОВ -->
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent Class="pa-3">
                    <div class="d-flex justify-space-between align-center mb-2 border-bottom pb-1">
                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 11px; color: #2c3e50;">ТЕКУЩИЙ СЧЕТЧИК СИГНАЛОВ ПОЛЯ:</MudText>
                        <MudChip T="string" Color="@(TotalSignalsCount > 1000 ? Color.Warning : Color.Default)" Size="Size.Small" Style="font-size: 10px; height: 18px;"><b>@TotalSignalsCount / 1000 на 1 ПЛК</b></MudChip>
                    </div>

                    <!-- Дискретные входы (DI) -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #2980b9;">ДИСКРЕТНЫЕ ВХОДЫ (DI)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.DiDryContact" Label="Сухой контакт =24В" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.DiWetContact" Label="Мокрый ~220В" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.DiFastCounter" Label="Счетчики/Импульс" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- Дискретные выходы (DO) -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #d35400;">ДИСКРЕТНЫЕ ВХОДЫ (DO)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoRelay" Label="Релейные выходы" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.DoTransistor" Label="Транзисторные (через реле)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- Аналоговые входы (AI) -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #8e44ad;">АНАЛОГОВЫЕ ВХОДЫ (AI)</MudText>
                    <MudGrid Dense="true" Spacing="1" Class="mb-3">
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.AiCurrent2W" Label="4-20мА 2-пров (актив)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.AiCurrent4W" Label="4-20мА 4-пров (пассив)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="signals.AiVoltage" Label="Напряжение 0-10В" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" />
                        </MudItem>
                        <MudItem xs="6" Class="mt-1">
                            <MudNumericField @bind-Value="signals.AiRtd" Label="Термосопротивления (Pt)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                        <MudItem xs="6" Class="mt-1">
                            <MudNumericField @bind-Value="signals.AiTc" Label="Термопары (Тип K, J)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                    </MudGrid>

                    <!-- Аналоговые выходы (AO) -->
                    <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #16a085;">АНАЛОГОВЫЕ ВХОДЫ (AO)</MudText>
                    <MudGrid Dense="true" Spacing="1">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoCurrent" Label="Ток 4-20 мА" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="signals.AoVoltage" Label="Напряжение 0-10 В" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 11px;" />
                        </MudItem>
                    </MudGrid>

                </MudCardContent>
            </MudCard>
            <MudCard Elevation="1" Class="mb-3 pa-2">
                <div class="d-flex justify-space-between align-center mb-1">
                    <MudText Typo="Typo.caption" Style="font-size: 11px;">Резерв каналов по ГОСТ:</MudText>
                    <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 11px;">@signals.ReservePercent%</MudText>
                </div>
                <MudSlider @bind-Value="signals.ReservePercent" Min="0" Max="40" Step="5" Color="Color.Primary" Class="ma-0 py-1" />
            </MudCard>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" OnClick="GenerateLayout" Disabled="@(selectedCpu is null)" Style="font-size: 11px; height: 32px;">
                Сгенерировать корзины
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       FullWidth="true"
                       Class="mt-4 py-2"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SavePlcProjectToDashboard"
                       Disabled="@(calcResult == null || !calcResult.Cabinets.Any())">
                Сохранить спецификацию ПЛК в проекты
            </MudButton>
        </MudItem>

                <!-- ВЫВОД РЕЗУЛЬТАТОВ (ПРАВАЯ КОЛОНКА) -->
        <MudItem xs="12" md="7">
            <MudCard Elevation="1" Style="min-height: 520px;">
                <MudCardHeader Class="py-1 px-3 border-bottom">
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle2" Style="font-size: 13px; font-weight: bold;">📐 Компоновка шкафов автоматизации</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-2">
                    @if (calcResult is null || !calcResult.Cabinets.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center font-italic text-muted mt-12" style="font-size: 11px;">
                            <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Medium" Class="mb-1" />
                            <MudText Style="font-size: 11px;">Задайте конфигурацию сигналов слева и нажмите кнопку генерации</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var cabinet in calcResult.Cabinets)
                        {
                            int visualUsefulWidthPx = (int)((cabinetWidth - 40 - 60 - 120) * 0.8);
                            int panelHeightMm = cabinetHeight - 70;
                            int visualPanelHeightPx = (int)(panelHeightMm * 0.4);

                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-2 mb-1 text-success" Style="font-size: 13px;">
                                🏢 ШКАФ АВТОМАТИЗАЦИИ №@cabinet.CabinetIndex (@(cabinet.Type == CabinetType.SingleSided ? "Односторонний" : "Двухсторонний"), Панель @panelHeightMm мм)
                            </MudText>

                            @if (cabinet.Type == CabinetType.SingleSided)
                            {
                                <!-- РЕНДЕР ОДНОСТОРОННЕЙ ЕДИНОЙ ПАНЕЛИ -->
                                <div class="d-flex cabinet-panel w-100 shadow-sm rounded mb-2" style="height: @(visualPanelHeightPx)px;">
                                    <div class="cable-duct duct-left"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">40х100</span></div>
                                    <div class="flex-grow-1 rail-zone" style="max-width: @(visualUsefulWidthPx)px; min-width: @(visualUsefulWidthPx)px;">
                                        <div class="cable-duct duct-h40">40х100</div>
                                        <div class="power-supply-zone">
                                            @if (cabinet.RecommendedPowerSupply is not null)
                                            {
                                                <div class="font-weight-bold text-white" style="font-size: 10px;">⚡ @cabinet.RecommendedPowerSupply.Name</div>
                                                <div style="font-size: 9px; color: #f1c40f; font-family: monospace;">@cabinet.RecommendedPowerSupply.Article (@cabinet.RecommendedPowerSupply.WidthMm мм)</div>
                                            }
                                        </div>
                                        <div class="cable-duct duct-h40">40х100</div>
                                        <div class="cable-duct duct-h40">40х100</div>

                                        @{
                                            int singleRailCounter = 1;
                                        }
                                        @foreach (var node in cabinet.SingleSide.Nodes)
                                        {
                                            @foreach (var basket in node.Baskets)
                                            {
                                                <div class="din-rail-row">
                                                    <div class="modules-line d-flex align-center justify-start flex-wrap">

                                                        @* ИСПРАВЛЕНО: Добавлен цикл перебора модулей внутри корзины *@
                                                        @foreach (var m in basket.Modules)
                                                        {
                                                            <div class="text-center rounded text-white style-plc-module @GetModuleColorClass(m.Type)"
                                                                 style="min-width: @(m.WidthMm * 0.8)px; max-width: @(m.WidthMm * 0.8)px; height: 50px; margin: 0 1px; overflow: hidden; display: inline-block; vertical-align: top;">

                                                                <!-- Выводим реальный шифр ОУ на основе типа вендора -->
                                                                <div class="font-weight-bold" style="font-size: 8px; line-height: 1.1; padding-top: 2px;">
                                                                    @if (selectedVendor == "REGUL")
                                                                    {
                                                                        @(m.Type == "CPU" ? "A1" : m.Type == "BUS" ? "G1" : "U" + (basket.Modules.IndexOf(m) + 1))
                                                                    }
                                                                    else
                                                                    {
                                                                        @GetUniqueModuleDesignation(m, cabinet)
                                                                    }
                                                                </div>

                                                                <!-- Вместо зашитого МВ210 выводим реальный артикул m.Article из plc-base.json -->
                                                                <div style="font-size: 7px; font-family: monospace; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; padding: 0 2px;">
                                                                    @m.Article
                                                                </div>

                                                                <div style="font-size: 6px; color: #e0e0e0;">
                                                                    @m.WidthMm мм
                                                                </div>
                                                            </div>
                                                        }

                                                    </div>
                                                    <div class="rail-label">--- CARRIER @singleRailCounter ---</div>
                                                </div>
                                                <div class="cable-duct duct-h60">60х100</div>
                                                { singleRailCounter++; }
                                            }
                                        }

                                        <div class="cable-entry-zone">ЗОНА ЗАВЕДЕНИЯ КАБЕЛЕЙ (СВОБОДНО: @(panelHeightMm - cabinet.SingleSide.TotalAllocatedHeightMm) мм)</div>
                                    </div>
                                    <div class="cable-duct duct-right"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">60х100</span></div>
                                </div>
                            }
                            else
                            {
                                <!-- РЕНДЕР ДВУХСТОРОННЕГО ШКАФА С ТАБАМИ -->
                                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0" Class="border rounded shadow-sm bg-white mb-2">
                                    
                                    <!-- ЛИЦЕВАЯ СТОРОНА (ПЛК) -->
                                    <MudTabPanel Text="ЛИЦЕВАЯ СТОРОНА (ПЛК и БП)" Style="font-size: 11px; font-weight: bold; padding: 4px 12px; height: 32px;">
                                        <div class="d-flex cabinet-panel w-100" style="height: @(visualPanelHeightPx)px;">
                                            <div class="cable-duct duct-left"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">40х100</span></div>
                                            <div class="flex-grow-1 rail-zone" style="max-width: @(visualUsefulWidthPx)px; min-width: @(visualUsefulWidthPx)px;">
                                                <div class="cable-duct duct-h40">40х100</div>
                                                <div class="power-supply-zone">
                                                    @if (cabinet.RecommendedPowerSupply is not null)
                                                    {
                                                        <div class="font-weight-bold text-white" style="font-size: 10px;">⚡ @cabinet.RecommendedPowerSupply.Name</div>
                                                        <div style="font-size: 9px; color: #f1c40f; font-family: monospace;">@cabinet.RecommendedPowerSupply.Article (@cabinet.RecommendedPowerSupply.WidthMm мм)</div>
                                                    }
                                                </div>
                                                <div class="cable-duct duct-h40">40х100</div>
                                                <div class="cable-duct duct-h40">40х100</div>

                                                @{ int frontRailCounter = 1; }
                                                @foreach (var node in cabinet.FrontSide.Nodes)
                                                {
                                                    @foreach (var basket in node.Baskets)
                                                    {
                                                        <div class="din-rail-row">
                                                            <div class="modules-line d-flex align-center justify-start">
                                                                @foreach (var m in basket.Modules)
                                                                {
                                                                    <div class="text-center rounded text-white style-plc-module @GetModuleColorClass(m.Type)" style="min-width: @(m.WidthMm * 0.8)px; height: 50px;">
                                                                        <div class="font-weight-bold" style="font-size: 8px;">@GetUniqueModuleDesignation(m, cabinet)</div>
                                                                        <div style="font-size: 7px; font-family: monospace;">@m.Article</div>
                                                                        <div style="font-size: 6px; color: #bdc3c7;">@m.WidthMm мм</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="rail-label">--- CARRIER FRONT @frontRailCounter ---</div>
                                                        </div>
                                                        <div class="cable-duct duct-h60">60х100</div>
                                                        { frontRailCounter++; }
                                                    }
                                                }
                                                <div class="cable-entry-zone">СВОБОДНАЯ ЗОНА ПАНЕЛИ: @(panelHeightMm - cabinet.FrontSide.TotalAllocatedHeightMm) мм</div>
                                            </div>
                                            <div class="cable-duct duct-right"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">60х100</span></div>
                                        </div>
                                    </MudTabPanel>
                                    <!-- ЗАДНЯЯ СТОРОНА (РЕЛЕ И КЛЕММЫ) -->
                                    <MudTabPanel Text="ЗАДНЯЯ СТОРОНА (РЕЛЕ И КЛЕММЫ)" Style="font-size: 11px; font-weight: bold; padding: 4px 12px; height: 32px;">
                                        <div class="d-flex cabinet-panel w-100" style="height: @(visualPanelHeightPx)px;">
                                            <div class="cable-duct duct-left"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">40х100</span></div>
                                            <div class="flex-grow-1 rail-zone" style="max-width: @(visualUsefulWidthPx)px; min-width: @(visualUsefulWidthPx)px;">
                                                <div class="cable-duct duct-h40">40х100</div>

                                                @{
                                                    int backRailCounter = 1;
                                                }
                                                @foreach (var node in cabinet.BackSide.Nodes)
                                                {
                                                    @foreach (var basket in node.Baskets)
                                                    {
                                                        <div class="din-rail-row" style="background-color: #232d37;">
                                                            <div class="modules-line d-flex align-center justify-start gap-1">
                                                                @foreach (var bEq in basket.Modules)
                                                                {
                                                                    @if (bEq.Type == "RELAY_BLOCK")
                                                                    {
                                                                        <div class="text-center rounded text-white d-flex align-center justify-center font-weight-bold" style="background-color: #d35400; width: @((bEq.WidthMm * 0.8))px; height: 42px; font-size: 9px; border: 1px dashed #fff; min-width: 60px;">
                                                                            РЕЛЕ FINDER (@cabinet.InterposingRelays.Count шт)
                                                                        </div>
                                                                    }
                                                                    else if (bEq.Type == "TERMINAL_BLOCK")
                                                                    {
                                                                        <div class="text-center rounded text-white d-flex align-center justify-center font-weight-bold" style="background-color: #7f8c8d; width: @((bEq.WidthMm * 0.8))px; height: 42px; font-size: 9px; border: 1px dashed #fff; min-width: 60px;">
                                                                            КЛЕММЫ IEK
                                                                        </div>
                                                                    }
                                                                }
                                                            </div>
                                                            <div class="rail-label" style="color: #e67e22;">--- CARRIER BACK @backRailCounter ---</div>
                                                        </div>
                                                        <div class="cable-duct duct-h60">60х100</div>
                                                        { backRailCounter++; }
                                                    }
                                                }
                                                <div class="cable-entry-zone">СВОБОДНАЯ ЗОНА ПАНЕЛИ: @(panelHeightMm - cabinet.BackSide.TotalAllocatedHeightMm) мм</div>
                                            </div>
                                            <div class="cable-duct duct-right"><span style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap;">60х100</span></div>
                                        </div>
                                    </MudTabPanel>
                                </MudTabs>
                            }

                            <!-- СВОДНЫЙ ИНЖЕНЕРНЫЙ ОТЧЕТ -->
                            <MudCard Class="mt-1 mb-3 pa-2 bg-light" Outlined="true" Style="font-size: 11px;">
                                <MudCardContent Class="pa-0">
                                    @if (cabinet.Type == CabinetType.SingleSided)
                                    {
                                        <div>📐 Занято на общей панели: <b>@cabinet.SingleSide.TotalAllocatedHeightMm мм</b> из @panelHeightMm мм. Свободный кабельный канал внизу: <b>@(panelHeightMm - cabinet.SingleSide.TotalAllocatedHeightMm) мм</b>.</div>
                                    }
                                    else
                                    {
                                        <div>📐 Занято на Лицевой панели: <b>@cabinet.FrontSide.TotalAllocatedHeightMm мм</b>. На Задней панели: <b>@cabinet.BackSide.TotalAllocatedHeightMm мм</b> из @panelHeightMm мм.</div>
                                    }
                                    <div class="mt-1 text-primary">📦 Реле Finder 24В: <b>@cabinet.InterposingRelays.Count шт.</b> | Клеммы IEK (серые/синие/PE): @(cabinet.Terminals.GreyTerminalsCount + cabinet.Terminals.BlueTerminalsCount + cabinet.Terminals.PeTerminalsCount) шт.</div>
                                </MudCardContent>
                            </MudCard>
                        }

                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2 font-weight-bold" Style="font-size: 11px;">
                            ✅ ИТОГО СФОРМИРОВАНО ШКАФОВ: @calcResult.Cabinets.Count шт. | Всего DIN-реек под ПЛК: @calcResult.TotalDinRailsRequired шт.
                        </MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>
</MudContainer>

<style>
    /* Монтажная панель шкафа с жесткой высотой по ГОСТ (1930 мм) */
    .cabinet-panel {
        background-color: #1a1a1a;
        border: 3px double #7f8c8d;
        padding: 0;
        position: relative;
        font-family: 'Courier New', monospace;
        box-sizing: border-box;
        width: 100% !important;
    }

    /* Перфорированные кабельные короба */
    .cable-duct {
        background: repeating-linear-gradient(45deg, #2d3748, #2d3748 6px, #1a202c 6px, #1a202c 12px);
        border: 1px solid #4a5568;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #f6ad55;
        font-size: 9px;
        font-weight: bold;
