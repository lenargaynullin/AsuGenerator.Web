                                        @* НИЖНЯЯ РЕЗЕРВНАЯ ЗОНА ШКАФА *@
                                        <div class="bottom-free-zone mt-auto d-flex align-center justify-center" style="height: 120px; background-color: rgba(255,255,255,0.01); border-top: 2px dashed #334155;">
