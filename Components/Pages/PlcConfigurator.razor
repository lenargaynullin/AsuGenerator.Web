@page "/plc-configurator"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@inject PlcCalculationService PlcCalcService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">⚙️ Расширенная конфигурация ПЛК и сигналов</MudText>

    <MudGrid>
        <!-- ВВОД СИГНАЛОВ -->
        <MudItem xs="12" md="5">
            <MudCard Elevation="3" Class="mb-4">
                <MudCardContent>
                    <MudSelect T="string" Label="Производитель" @bind-Value="selectedVendor" Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem Value="@("ОВЕН")">ОВЕН</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="PlcComponent" Label="Контроллер (CPU)" @bind-Value="selectedCpu" Variant="Variant.Outlined">
                        @foreach (var cpu in availableCpus.Where(c => c.Name.Contains(selectedVendor)))
                        {
                            <MudSelectItem Value="@cpu">@cpu.Name (@cpu.Article)</MudSelectItem>
                        }
                    </MudSelect>
                </MudCardContent>
            </MudCard>

            <MudExpansionPanels Multipl="true" Class="mb-4">
                <!-- Группа DI -->
                <MudExpansionPanel Text="Дискретные входы (DI)" MaxHeight="300">
                    <MudGrid Dense="true">
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.DiDryContact" Label="Сухой контакт (=24В)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.DiWetContact" Label="Мокрый контакт (~220В / внешнее питание)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.DiFastCounter" Label="Высокочастотные (счетчики / энкодеры)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Группа DO -->
                <MudExpansionPanel Text="Дискретные выходы (DO)">
                    <MudGrid Dense="true">
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.DoRelay" Label="Релейные выходы (напрямую)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.DoTransistor" Label="Транзисторные (требуют внешних реле)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Группа AI -->
                <MudExpansionPanel Text="Аналоговые входы (AI)">
                    <MudGrid Dense="true">
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AiCurrent2W" Label="Токовая петля 4-20 мА (2-проводная, питание от шкафа)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AiCurrent4W" Label="Токовая петля 4-20 мА (4-проводная, внешнее питание)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AiVoltage" Label="Сигнал напряжения (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AiRtd" Label="Термосопротивления (Pt100, Pt1000, 50М)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AiTc" Label="Термопары (Тип K, J, S)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Группа AO -->
                <MudExpansionPanel Text="Аналоговые выходы (AO)">
                    <MudGrid Dense="true">
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AoCurrent" Label="Унифицированный ток (4-20 мА)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="signals.AoVoltage" Label="Унифицированное напряжение (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
            <MudCard Elevation="3" Class="mb-4 p-2">
                <MudSlider @bind-Value="signals.ReservePercent" Min="0" Max="40" Step="5" Color="Color.Primary">
                    Резерв каналов по ГОСТ: <b>@signals.ReservePercent%</b>
                </MudSlider>
            </MudCard>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="GenerateLayout" Disabled="@(selectedCpu == null)">
                Сгенерировать корзины
            </MudButton>
        </MudItem>

        <!-- ВЫВОД РЕЗУЛЬТАТОВ -->
        <MudItem xs="12" md="7">
            <MudCard Elevation="3" Style="min-height: 600px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">📐 Скомпонованные шасси ПЛК</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (!generatedBaskets.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center font-italic text-muted mt-12">
                            <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Large" Class="mb-2"/>
                            <MudText>Задайте конфигурацию сигналов слева</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var basket in generatedBaskets)
                        {
                            <div class="border-2 border-solid mud-border-primary rounded p-3 mb-4 bg-light">
                                <div class="d-flex justify-content-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                        <b>Корзина №@basket.BasketIndex</b> @(basket.BasketIndex == 0 ? "(Основная)" : "(Расширения)")
                                    </MudText>
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Ширина: @basket.TotalWidthMm мм</MudChip>
                                </div>

                                @if (!string.IsNullOrEmpty(basket.BusCouplerArticle))
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2 py-0">
                                        Шинный куплер: <b>@basket.BusCouplerArticle</b>
                                    </MudAlert>
                                }

                                <div class="d-flex flex-wrap gap-1 p-2 rounded style-din-rail">
                                    @foreach (var mod in basket.Modules)
                                    {
                                        <div class="p-2 text-center rounded text-white style-plc-module @GetModuleColorClass(mod.Type)" 
                                             style="min-width: 75px; font-size: 11px;" title="@mod.Name">
                                            <b>@FormatType(mod.Type)</b>
                                            <br />
                                            <span style="font-size: 9px;">@mod.Article</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <MudCard Class="mt-4 p-3 bg-light" Outlined="true">
                            <MudText Typo="Typo.subtitle2"><b>Дополнительные данные для спецификации шкафа:</b></MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">
                                🔌 Потребность в пром. реле развязки (для мокрых DI и транзисторных DO): 
                                <b>@(signals.DiWetContact + signals.DoTransistor) шт.</b>
                            </MudText>
                            <MudText Typo="Typo.body2">
                                🔋 Потребность в питании датчиков 4-20мА (2-проводных): 
                                <b>@signals.AiCurrent2W каналов</b> (Рекомендуется доп. БП =24В 2.5А).
                            </MudText>
                        </MudCard>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .style-din-rail { background-color: #2c3e50 !important; border-bottom: 4px solid #7f8c8d; }
    .style-plc-module { border: 1px solid rgba(255,255,255,0.2); box-shadow: inset 0 0 5px rgba(0,0,0,0.5); }
    .bg-cpu { background-color: #27ae60; }
    .bg-di { background-color: #2980b9; }
    .bg-do { background-color: #d35400; }
    .bg-ai-cur { background-color: #8e44ad; }
    .bg-ai-temp { background-color: #16a085; }
    .bg-ao { background-color: #2c3e50; }
</style>

@code {
    private string selectedVendor = "ОВЕН";
    private SignalRequirement signals = new();
    private PlcComponent? selectedCpu;
    private PlcComponent busCoupler = new() { Article = "МВ210-101", Name = "Сетевой соединитель", Type = "BusCoupler", WidthMm = 55 };

    private List<PlcComponent> availableCpus = new();
    private List<PlcComponent> availableModulesInDb = new();
    private List<PlcBasket> generatedBaskets = new();

    protected override void OnInitialized()
    {
        LoadMockPlcDatabase();
        selectedCpu = availableCpus.FirstOrDefault(c => c.Name.Contains(selectedVendor));
    }
    private void OnVendorChanged()
    {
        selectedCpu = availableCpus.FirstOrDefault(c => c.Name.Contains(selectedVendor));
        generatedBaskets.Clear();
    }

    private void GenerateLayout()
    {
        if (selectedCpu == null) return;
        generatedBaskets = PlcCalcService.GeneratePlcBaskets(
            signals,
            selectedCpu,
            availableModulesInDb,
            busCoupler,
            maxSlotsPerBasket: 8
        );
    }

    private string FormatType(string type) => type switch
    {
        "AI_Current" => "AI (Ток)",
        "AI_Temp" => "AI (Темп)",
        _ => type
    };

    private string GetModuleColorClass(string type) => type switch
    {
        "CPU" => "bg-cpu",
        "DI" => "bg-di",
        "DO" => "bg-do",
        "AI_Current" => "bg-ai-cur",
        "AI_Temp" => "bg-ai-temp",
        "AO" => "bg-ao",
        _ => "bg-unknown"
    };

    private void LoadMockPlcDatabase()
    {
        availableCpus = new List<PlcComponent> {
            new() { Article = "ПЛК210-01", Name = "ОВЕН ПЛК210", Type = "CPU", DiChannels = 12, DoChannels = 4, WidthMm = 105, SlotsOccupied = 2 }
        };

        availableModulesInDb = new List<PlcComponent> {
            new() { Article = "МВ210-202", Name = "Модуль 16DI", Type = "DI", DiChannels = 16, WidthMm = 55 },
            new() { Article = "МУ210-401", Name = "Модуль 16DO (Реле)", Type = "DO", DoChannels = 16, WidthMm = 55 },
            new() { Article = "МВ210-101", Name = "Модуль 8AI (4-20мА/0-10В)", Type = "AI_Current", AiChannels = 8, WidthMm = 55 },
            new() { Article = "МВ210-102", Name = "Модуль 8AI (RTD/TC)", Type = "AI_Temp", AiChannels = 8, WidthMm = 55 },
            new() { Article = "МУ210-501", Name = "Модуль 6AO", Type = "AO", AoChannels = 6, WidthMm = 55 }
        };
    }
}
