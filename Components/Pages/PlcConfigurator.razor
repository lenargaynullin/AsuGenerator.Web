    // Диагностика
    private void DiagnoseDatabase()
    {
        if (_plcDbRoot?.Components == null)
        {
            Snackbar.Add("База не загружена!", Severity.Error);
            return;
        }

        var vendors = _plcDbRoot.Components
            .Select(c => c.Vendor)
            .Distinct()
            .ToList();

        var cpus = _plcDbRoot.Components
            .Where(c => c.Category != null && c.Category.Equals("cpu", StringComparison.OrdinalIgnoreCase))
            .ToList();

        var message = $"Вендоры в базе: {string.Join(", ", vendors)}\n";
        message += $"CPU в базе: {cpus.Count} шт.\n";
        foreach (var cpu in cpus)
        {
            message += $"  - {cpu.PartNumber} | Vendor='{cpu.Vendor}' | Category='{cpu.Category}' | FamilyId='{cpu.FamilyId}'\n";
        }
        message += $"\nТекущий selectedVendor='{selectedVendor}'";
        message += $"\navailableCpus.Count={availableCpus.Count}";

        Snackbar.Add(message, Severity.Info);
    }

