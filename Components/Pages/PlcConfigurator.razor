                                    @* --- 2. ПРАВЫЙ ВЕРТИКАЛЬНЫЙ КОРОБ 60 мм (=24В) --- *@
                                    <div class="vertical-duct-right text-center" style="width: 48px; min-width: 48px; background-color: #334155; color: #94a3b8; font-family: monospace; font-size: 9px; display: flex; align-items: center; justify-content: center; border-left: 1px solid #475569; writing-mode: vertical-lr; transform: rotate(180deg); padding: 10px 0;">
                                        ВЕРТИКАЛЬНЫЙ КОРОБ 60х100 СЕРЫЙ (=24В)
                                    </div>

                                </div>
