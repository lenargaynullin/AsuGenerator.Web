@page "/plc-comparison"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@using System.IO
@inject ExcelParserService ParserService
@inject PlcComparisonEngine ComparisonEngine
@inject ISnackbar Snackbar
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">
    <div class="mb-6">
        <MudText Typo="Typo.h5" Color="Color.Primary"><b>Сравнительный анализ систем ПЛК (ТКП)</b></MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Сравнение бюджетов, габаритов и технических назначений контроллеров REGUL R500 и ОВЕН</MudText>
    </div>

    <MudGrid>
        <!-- Левая колонка: Ввод емкости сигналов проекта -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rounded-lg" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-3"><b>1. Информационная мощность из ТЗ</b></MudText>
                
                <MudNumericField @bind-Value="_aiCount" Label="Аналоговые входы (AI 4-20мА)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Class="mb-2" />
                <MudNumericField @bind-Value="_aoCount" Label="Аналоговые выходы (AO 4-20мА)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Class="mb-2" />
                <MudNumericField @bind-Value="_diCount" Label="Дискретные входы (DI =24В)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Class="mb-2" />
                <MudNumericField @bind-Value="_doCount" Label="Дискретные выходы (DO =24В, 0.5А)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Class="mb-4" />

                <MudSelect T="double" @bind-Value="_cabinetWidth" Label="Ширина шкафа (мм)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
                    <MudSelectItem Value="600.0">600 мм</MudSelectItem>
                    <MudSelectItem Value="800.0">800 мм</MudSelectItem>
                    <MudSelectItem Value="1000.0">1000 мм</MudSelectItem>
                </MudSelect>

                <MudButton Variant="Variant.Filled" 
                           Style="background-color: #3cb890; color: white; font-weight: bold;" 
                           FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Calculate"
                           OnClick="RunComparison">
                    Рассчитать сравнение
                </MudButton>
            </MudPaper>
        </MudItem>

        <!-- Правая колонка: Аналитические карточки ТКП и выводы -->
        <MudItem xs="12" md="8">
            @if (_tkpReport != null && _tkpReport.Any())
            {
                <MudGrid Class="mb-4">
                    @* Карточка ОВЕН *@
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-4 rounded-lg style-tkp-card style-card-oven">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle1"><b>@_tkpReport["ОВЕН"].VendorName</b></MudText>
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">@_tkpReport["ОВЕН"].SeriesId</MudChip>
                            </div>
                            <MudDivider Class="my-2" />
                            <div class="d-flex flex-column gap-1 my-3" style="font-size: 13px;">
                                <MudText Typo="Typo.body2">Назначение: <b>@_tkpReport["ОВЕН"].TargetApplication</b></MudText>
                                <MudText Typo="Typo.body2">Всего узлов/крейтов: <b>@_tkpReport["ОВЕН"].TotalRacksCount шт.</b></MudText>
                                <MudText Typo="Typo.body2">Необходимо шкафов: <b>@_tkpReport["ОВЕН"].TotalCabinetsCount шт.</b></MudText>
                            </div>
                            <div class="mt-4">
                                <MudText Typo="Typo.h5" Color="Color.Info" Class="font-weight-bold">
                                    @_tkpReport["ОВЕН"].TotalHardwareCostRub.ToString("N0") ₽
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Базовая себестоимость спецификации</MudText>
                            </div>
                        </MudPaper>
                    </MudItem>

                    @* Карточка REGUL *@
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-4 rounded-lg style-tkp-card style-card-regul">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle1" Style="color: #3cb890;"><b>@_tkpReport["REGUL"].VendorName</b></MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="style-regul-chip">@_tkpReport["REGUL"].SeriesId</MudChip>
                            </div>
                            <MudDivider Class="my-2" />
                            <div class="d-flex flex-column gap-1 my-3" style="font-size: 13px;">
                                <MudText Typo="Typo.body2">Назначение: <b>@_tkpReport["REGUL"].TargetApplication</b></MudText>
                                <MudText Typo="Typo.body2">Всего узлов/крейтов: <b>@_tkpReport["REGUL"].TotalRacksCount шт.</b></MudText>
                                <MudText Typo="Typo.body2">Необходимо шкафов: <b>@_tkpReport["REGUL"].TotalCabinetsCount шт.</b></MudText>
                            </div>
                            <div class="mt-4">
                                <MudText Typo="Typo.h5" Style="color: #3cb890;" Class="font-weight-bold">
                                    @_tkpReport["REGUL"].TotalHardwareCostRub.ToString("N0") ₽
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Резервирование + Искрозащита Exi</MudText>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* Аналитическое резюме для ГИПа *@
                <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Square="true" Class="rounded-lg pa-4" Style="background-color: #1e293b; color: #f8fafc;">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Style="color: #3cb890;" Size="Size.Large" />
                        <div style="font-size: 13px; line-height: 1.5;">
                            <b>Инженерный анализ отклонений бюджета:</b>
                            Разница в стоимости между системами составляет
                            <b style="color: #3cb890; font-size: 14px;">@((_tkpReport["REGUL"].TotalHardwareCostRub - _tkpReport["ОВЕН"].TotalHardwareCostRub).ToString("N0")) ₽</b>.
                            Увеличение бюджета закупки для линейки Прософт REGUL R500 обусловлено применением отказоустойчивой резервированной архитектуры (две шины RegulBus, резерв ЦП и БП)
                            и поканальной взрывозащиты, что технически обязательно для систем ПАЗ уровня <b>SIL3 (Ростехнадзор)</b> на опасных производственных объектах.
                        </div>
                    </div>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                    Введите количество технологических сигналов проекта в левой панели и нажмите «Рассчитать сравнение» для вывода технико-коммерческой аналитики.
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _aiCount = 24;
    private int _aoCount = 8;
    private int _diCount = 120;
    private int _doCount = 32;
    private double _cabinetWidth = 800.0;

    private Dictionary<string, PlcComparisonResult>? _tkpReport;
    private PlcBaseRoot _plcDbRoot = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Читаем единую базу ПЛК
            string jsonPath = Path.Combine(Env.WebRootPath, "Configs", "plc-base.json");
            if (File.Exists(jsonPath))
            {
                string jsonText = await File.ReadAllTextAsync(jsonPath);
                _plcDbRoot = System.Text.Json.JsonSerializer.Deserialize<PlcBaseRoot>(jsonText) ?? new();
            }

            // 2. ПЕРЕХВАТ ПАРАМЕТРОВ ИЗ КОНФИГУРАТОРА: Парсим URL-строку
            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var queryStrings = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            if (queryStrings.TryGetValue("di", out var diVal) && int.TryParse(diVal, out int di)) _diCount = di;
            if (queryStrings.TryGetValue("do", out var doVal) && int.TryParse(doVal, out int @do)) _doCount = @do;
            if (queryStrings.TryGetValue("ai", out var aiVal) && int.TryParse(aiVal, out int ai)) _aiCount = ai;
            if (queryStrings.TryGetValue("ao", out var aoVal) && int.TryParse(aoVal, out int ao)) _aoCount = ao;
            if (queryStrings.TryGetValue("width", out var wVal) && double.TryParse(wVal, out double w)) _cabinetWidth = w;

            // Если параметры были переданы, сразу автоматически запускаем ТКП расчет без лишних кликов
            if (diVal.Count > 0 || doVal.Count > 0 || aiVal.Count > 0 || aoVal.Count > 0)
            {
                RunComparison();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка инициализации ТКП: {ex.Message}", Severity.Error);
        }
    }


    private void RunComparison()
    {
        var inputSignals = new List<IoSignalRow>();
        if (_diCount > 0) inputSignals.Add(new IoSignalRow { SignalType = "DI", TotalWithReserve = _diCount });
        if (_doCount > 0) inputSignals.Add(new IoSignalRow { SignalType = "DO", TotalWithReserve = _doCount });
        if (_aiCount > 0) inputSignals.Add(new IoSignalRow { SignalType = "AI", TotalWithReserve = _aiCount });
        if (_aoCount > 0) inputSignals.Add(new IoSignalRow { SignalType = "AO", TotalWithReserve = _aoCount });

        if (inputSignals.Any())
        {
            _tkpReport = ComparisonEngine.CompareSystems(inputSignals, _cabinetWidth, _plcDbRoot);
            Snackbar.Add("Технико-коммерческое сравнение успешно пересчитано!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Введите хотя бы один технологический сигнал для расчета!", Severity.Warning);
            _tkpReport = null;
        }
    }
}

<style>
    .style-tkp-card {
        height: 100%;
        transition: box-shadow 0.2s ease-in-out;
    }

        .style-tkp-card:hover {
            box-shadow: var(--mud-elevation-3);
        }

    .style-card-oven {
        border-top: 4px solid var(--mud-palette-info);
    }

    .style-card-regul {
        border-top: 4px solid #3cb890;
    }

    .style-regul-chip {
        color: #3cb890 !important;
        background-color: rgba(60, 184, 144, 0.1) !important;
        font-weight: bold;
    }
</style>
