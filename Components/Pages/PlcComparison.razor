@page "/plc-comparison"
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services
@inject AsuGenerator.Web.Services.DocumentGenerator DocGenerator
@using System.IO
@using System.Text.Json
@using OfficeOpenXml
@inject ExcelParserService ParserService
@inject PlcComparisonEngine ComparisonEngine
@inject ISnackbar Snackbar
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject NavigationManager NavManager
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-12">
    
    @* Hero-заголовок *@
    <div class="mb-6 text-center">
        <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold mb-2">
            📊 Сравнительный анализ систем ПЛК
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Технико-коммерческое предложение для согласования с ГИПом и заказчиком
        </MudText>
    </div>

    <MudGrid>
        @* Левая колонка: Ввод сигналов (25 типов) *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rounded-lg" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <b>1. Информационная мощность из ТЗ (25 типов сигналов)</b>
                </MudText>
                
                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #8e44ad;">АНАЛОГОВЫЕ ВХОДЫ (AI)</MudText>
                <MudNumericField @bind-Value="_signals.AiNisCurrent2W" Label="AI-NIS (4-20 mA, 2w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiNisCurrent4W" Label="AI-NIS (4-20 mA, 4w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiRtdNis3W" Label="AI-RTD-NIS (3w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiNisPl3W" Label="AI-NIS (Pl, 3w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #e67e22;">AI-IS (Искробезопасные)</MudText>
                <MudNumericField @bind-Value="_signals.AiIsCurrent2W" Label="AI-IS (4-20 mA, 2w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiIsCurrent4W" Label="AI-IS (4-20 mA, 4w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiIsPl3W" Label="AI-IS (Pl, 3w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #c0392b;">AI-R (Резервированные)</MudText>
                <MudNumericField @bind-Value="_signals.AiRNisCurrent2W" Label="AI-R-NIS (4-20 mA, 2w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiRNisCurrent4W" Label="AI-R-NIS (4-20 mA, 4w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiRIsCurrent2W" Label="AI-R-IS (4-20 mA, 2w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AiRIsCurrent4W" Label="AI-R-IS (4-20 mA, 4w)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #16a085;">АНАЛОГОВЫЕ ВЫХОДЫ (AO)</MudText>
                <MudNumericField @bind-Value="_signals.AoNisCurrent" Label="AO-NIS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AoNisVoltage" Label="AO-NIS (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AoIsCurrent" Label="AO-IS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AoIsVoltage" Label="AO-IS (0-10 В)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AoRIsCurrent" Label="AO-R-IS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.AoRNisCurrent" Label="AO-R-NIS (4-20 mA)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #2980b9;">ДИСКРЕТНЫЕ ВХОДЫ (DI)</MudText>
                <MudNumericField @bind-Value="_signals.DiIsNamur" Label="DI-IS (NAMUR)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DiNisDryContact" Label="DI-NIS с.к." Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DiNis24VDC" Label="DI-NIS (=24VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DiNisVfg" Label="DI-NIS (VFG)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DiNisMcc230VAC" Label="DI-NIS (MCC 230VAC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DiNisMcc220VDC" Label="DI-NIS (MCC 220VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="font-size: 10px; color: #d35400;">ДИСКРЕТНЫЕ ВЫХОДЫ (DO)</MudText>
                <MudNumericField @bind-Value="_signals.DoNisDryContact" Label="DO-NIS (VFC NO)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DoNis24VDC" Label="DO-NIS (24VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DoNisMcc230VAC" Label="DO-NIS (MCC 230VAC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-1" />
                <MudNumericField @bind-Value="_signals.DoNisMcc220VDC" Label="DO-NIS (MCC 220VDC)" Min="0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="font-size: 10px;" Class="mb-2" />

                <MudSelect T="double" @bind-Value="_cabinetWidth" 
                           Label="Ширина шкафа (мм)" Variant="Variant.Outlined" 
                           Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="600.0">600 мм</MudSelectItem>
                    <MudSelectItem Value="800.0">800 мм</MudSelectItem>
                    <MudSelectItem Value="1000.0">1000 мм</MudSelectItem>
                </MudSelect>

                <MudNumericField @bind-Value="_signals.ReservePercent" Label="Резерв %" Min="0" Max="40" Step="5" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-2" />

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary"
                           FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Calculate"
                           OnClick="RunComparison">
                    Рассчитать сравнение
                </MudButton>
                
                @* Кнопка экспорта — показывается только после расчёта *@
                @if (_tkpReport != null && _tkpReport.Any())
                {
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Success"
                               FullWidth="true" 
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadComparisonExcel">
                        Скачать сравнение в Excel
                    </MudButton>
                }
            </MudPaper>
        </MudItem>

        @* Правая колонка: Результаты сравнения *@
        <MudItem xs="12" md="8">
            @if (_tkpReport != null && _tkpReport.Any())
            {
                @* Таблица сравнения в стиле ТКП *@
                <MudTable Items="@GetComparisonRows()" 
                          Hover="true" 
                          Striped="true" 
                          Dense="true" 
                          Class="rounded-lg overflow-hidden mb-4"
                          Style="border: 1px solid var(--mud-palette-lines-default);">
                    <HeaderContent>
                        <MudTh Style="font-weight: bold; background-color: #f5f5f5;">Параметр</MudTh>
                        @foreach (var kvp in _tkpReport)
                        {
                            <MudTh Style="text-align: center; font-weight: bold; background-color: #f5f5f5;">
                                @kvp.Value.VendorName
                            </MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="font-weight: 500;">@context.ParamName</MudTd>
                        @foreach (var kvp in _tkpReport)
                        {
                            var value = context.Values.GetValueOrDefault(kvp.Key, "—");
                            var cellStyle = GetCellStyle(context.ParamName, kvp.Key);
                            
                            <MudTd Style="@cellStyle">
                                @value
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>

                @* Сводный блок: итоги и рекомендация *@
                <MudAlert Severity="Severity.Normal"
                          Variant="Variant.Filled"
                          Square="true"
                          Class="rounded-lg pa-4"
                          Style="background-color: #1e293b; color: #f8fafc;">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Insights"
                                 Style="color: #3cb890;" Size="Size.Large" />
                        <div style="font-size: 13px; line-height: 1.6;">
                            <b>📋 Выводы для технико-коммерческого предложения:</b><br />

                            💰 <b style="color: #4caf50;">@GetCheapestVendor().VendorName</b> — минимальная стоимость:
                            <b>@GetCheapestVendor().TotalHardwareCostRub.ToString("N0") ₽</b><br />

                            📦 <b style="color: #2196F3;">@GetFewestCabinetsVendor().VendorName</b> — самая компактная компоновка:
                            <b>@GetFewestCabinetsVendor().TotalCabinetsCount шкаф.</b><br />

                            ⚡ <b style="color: #ff9800;">@GetMostExpensiveVendor().VendorName</b> — максимальный бюджет:
                            <b>@GetMostExpensiveVendor().TotalHardwareCostRub.ToString("N0") ₽</b>
                            @if (GetMostExpensiveVendor().VendorName.Contains("REGUL"))
                            {
                                <span>(включая резервирование и искрозащиту Exi для SIL3)</span>
                            }

                            <br /><br />
                            <b>Рекомендация:</b> Для систем ПАЗ с требованиями SIL3 —
                            <b style="color: #3cb890;">@GetMostExpensiveVendor().VendorName</b>.
                            Для общепромышленных систем —
                            <b style="color: #4caf50;">@GetCheapestVendor().VendorName</b>.
                        </div>
                    </div>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                    Введите количество технологических сигналов проекта в левой панели 
                    и нажмите «Рассчитать сравнение» для вывода технико-коммерческой аналитики.
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private SignalRequirement _signals = new()
    {
        AiNisCurrent2W = 8,
        AiNisCurrent4W = 4,
        AiRtdNis3W = 6,
        AiNisPl3W = 2,
        AiIsCurrent2W = 4,
        AiIsCurrent4W = 0,
        AiIsPl3W = 0,
        AiRNisCurrent2W = 0,
        AiRNisCurrent4W = 0,
        AiRIsCurrent2W = 0,
        AiRIsCurrent4W = 0,
        AoNisCurrent = 4,
        AoNisVoltage = 2,
        AoIsCurrent = 2,
        AoIsVoltage = 0,
        AoRIsCurrent = 0,
        AoRNisCurrent = 0,
        DiIsNamur = 8,
        DiNisDryContact = 20,
        DiNis24VDC = 40,
        DiNisVfg = 4,
        DiNisMcc230VAC = 24,
        DiNisMcc220VDC = 12,
        DoNisDryContact = 8,
        DoNis24VDC = 16,
        DoNisMcc230VAC = 4,
        DoNisMcc220VDC = 4,
        ReservePercent = 20
    };
    private double _cabinetWidth = 800.0;

    private Dictionary<string, PlcComparisonResult>? _tkpReport;
    private PlcBaseRoot _plcDbRoot = new();

    // Модель строки таблицы сравнения
    private class ComparisonRow
    {
        public string ParamName { get; set; } = "";
        public Dictionary<string, string> Values { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Читаем единую базу ПЛК
            string jsonPath = Path.Combine(Env.WebRootPath, "Configs", "plc-base.json");
            if (File.Exists(jsonPath))
            {
                string jsonText = await File.ReadAllTextAsync(jsonPath);
                _plcDbRoot = JsonSerializer.Deserialize<PlcBaseRoot>(jsonText) ?? new();
            }

            // Перехват параметров из конфигуратора — 25 типов сигналов
            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var queryStrings = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            bool hasParams = false;

            // AI
            if (TryParseInt(queryStrings, "ai_nis2w", out int v)) { _signals.AiNisCurrent2W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_nis4w", out v)) { _signals.AiNisCurrent4W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_rtd3w", out v)) { _signals.AiRtdNis3W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_pl3w", out v)) { _signals.AiNisPl3W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_is2w", out v)) { _signals.AiIsCurrent2W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_is4w", out v)) { _signals.AiIsCurrent4W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_isp3w", out v)) { _signals.AiIsPl3W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_rn2w", out v)) { _signals.AiRNisCurrent2W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_rn4w", out v)) { _signals.AiRNisCurrent4W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_ri2w", out v)) { _signals.AiRIsCurrent2W = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ai_ri4w", out v)) { _signals.AiRIsCurrent4W = v; hasParams = true; }

            // AO
            if (TryParseInt(queryStrings, "ao_nis", out v)) { _signals.AoNisCurrent = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ao_nisv", out v)) { _signals.AoNisVoltage = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ao_is", out v)) { _signals.AoIsCurrent = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ao_isv", out v)) { _signals.AoIsVoltage = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ao_ri", out v)) { _signals.AoRIsCurrent = v; hasParams = true; }
            if (TryParseInt(queryStrings, "ao_rn", out v)) { _signals.AoRNisCurrent = v; hasParams = true; }

            // DI
            if (TryParseInt(queryStrings, "di_nam", out v)) { _signals.DiIsNamur = v; hasParams = true; }
            if (TryParseInt(queryStrings, "di_dry", out v)) { _signals.DiNisDryContact = v; hasParams = true; }
            if (TryParseInt(queryStrings, "di_24v", out v)) { _signals.DiNis24VDC = v; hasParams = true; }
            if (TryParseInt(queryStrings, "di_vfg", out v)) { _signals.DiNisVfg = v; hasParams = true; }
            if (TryParseInt(queryStrings, "di_mcc230", out v)) { _signals.DiNisMcc230VAC = v; hasParams = true; }
            if (TryParseInt(queryStrings, "di_mcc220", out v)) { _signals.DiNisMcc220VDC = v; hasParams = true; }

            // DO
            if (TryParseInt(queryStrings, "do_vfc", out v)) { _signals.DoNisDryContact = v; hasParams = true; }
            if (TryParseInt(queryStrings, "do_24v", out v)) { _signals.DoNis24VDC = v; hasParams = true; }
            if (TryParseInt(queryStrings, "do_mcc230", out v)) { _signals.DoNisMcc230VAC = v; hasParams = true; }
            if (TryParseInt(queryStrings, "do_mcc220", out v)) { _signals.DoNisMcc220VDC = v; hasParams = true; }

            // Общие
            if (TryParseInt(queryStrings, "reserve", out v)) { _signals.ReservePercent = v; }
            if (TryParseDouble(queryStrings, "width", out double w)) { _cabinetWidth = w; }

            // Автозапуск, если параметры переданы
            if (hasParams) RunComparison();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка инициализации ТКП: {ex.Message}", Severity.Error);
        }
    }

    private bool TryParseInt(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> dict, string key, out int value)
    {
        value = 0;
        if (dict.TryGetValue(key, out var val) && int.TryParse(val, out int parsed))
        {
            value = parsed;
            return true;
        }
        return false;
    }

    private bool TryParseDouble(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> dict, string key, out double value)
    {
        value = 0;
        if (dict.TryGetValue(key, out var val) && double.TryParse(val, out double parsed))
        {
            value = parsed;
            return true;
        }
        return false;
    }

    private PlcComparisonResult GetCheapestVendor()
    {
        return _tkpReport!.Values.OrderBy(v => v.TotalHardwareCostRub).First();
    }

    private PlcComparisonResult GetMostExpensiveVendor()
    {
        return _tkpReport!.Values.OrderByDescending(v => v.TotalHardwareCostRub).First();
    }

    private PlcComparisonResult GetFewestCabinetsVendor()
    {
        return _tkpReport!.Values.OrderBy(v => v.TotalCabinetsCount).First();
    }
    private void RunComparison()
    {
        if (_signals.TotalDI > 0 || _signals.TotalDO > 0 || _signals.TotalAI > 0 || _signals.TotalAO > 0)
        {
            _tkpReport = ComparisonEngine.CompareSystems(_signals, _cabinetWidth, _plcDbRoot);
            Snackbar.Add("Технико-коммерческое сравнение успешно пересчитано!", Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Введите хотя бы один технологический сигнал для расчета!", Severity.Warning);
            _tkpReport = null;
        }
    }

    // Формирует строки таблицы сравнения
    private List<ComparisonRow> GetComparisonRows()
    {
        if (_tkpReport == null || !_tkpReport.Any()) return new();

        var rows = new List<ComparisonRow>();
        var vendorKeys = _tkpReport.Keys.ToList();

        // Строка 1: Серия контроллера
        var seriesRow = new ComparisonRow { ParamName = "Серия контроллера" };
        foreach (var v in vendorKeys) seriesRow.Values[v] = _tkpReport[v].SeriesId;
        rows.Add(seriesRow);

        // Строка 2: Назначение
        var appRow = new ComparisonRow { ParamName = "Назначение" };
        foreach (var v in vendorKeys) appRow.Values[v] = _tkpReport[v].TargetApplication;
        rows.Add(appRow);

        // Строка 3: Количество крейтов
        var racksRow = new ComparisonRow { ParamName = "Всего крейтов / узлов" };
        foreach (var v in vendorKeys) racksRow.Values[v] = $"{_tkpReport[v].TotalRacksCount} шт.";
        rows.Add(racksRow);

        // Строка 4: Количество шкафов
        var cabinetsRow = new ComparisonRow { ParamName = "Необходимо шкафов" };
        foreach (var v in vendorKeys) cabinetsRow.Values[v] = $"{_tkpReport[v].TotalCabinetsCount} шт.";
        rows.Add(cabinetsRow);

        // Строка 5: Cрок поставки
        var deliveryRow = new ComparisonRow { ParamName = "Срок поставки" };
        foreach (var v in vendorKeys) deliveryRow.Values[v] = _tkpReport[v].DeliveryTime;
        rows.Add(deliveryRow);

        // Строка 6: Стоимость (выделенная)
        var costRow = new ComparisonRow { ParamName = "💰 Стоимость оборудования" };
        foreach (var v in vendorKeys) costRow.Values[v] = $"{_tkpReport[v].TotalHardwareCostRub.ToString("N0")} ₽";
        rows.Add(costRow);

        return rows;
    }

    // Проверяет, является ли вендор самым дешёвым
    private bool IsLowestPrice(string vendorKey)
    {
        if (_tkpReport == null || !_tkpReport.Any()) return false;
        var minCost = _tkpReport.Values.Min(v => v.TotalHardwareCostRub);
        return _tkpReport[vendorKey].TotalHardwareCostRub == minCost;
    }

    // Вычисляет CSS-стиль для ячейки таблицы
    private string GetCellStyle(string paramName, string vendorKey)
    {
        var styles = new List<string> { "text-align: center" };
        
        if (paramName.Contains("Стоимость"))
        {
            styles.Add("font-weight: bold");
            styles.Add("font-size: 16px");
            
            if (IsLowestPrice(vendorKey))
            {
                styles.Add("color: #4caf50");
            }
        }
        
        return string.Join("; ", styles) + ";";
    }

    private async Task DownloadComparisonExcel()
    {
        if (_tkpReport == null) return;

        try
        {
            // 1. Формируем список сигналов для шапки документа Excel
            var inputSignals = new List<(string SignalType, int Count)>();
            if (_signals.TotalDI > 0) inputSignals.Add(("Дискретные входы (DI)", _signals.TotalDI));
            if (_signals.TotalDO > 0) inputSignals.Add(("Дискретные выходы (DO)", _signals.TotalDO));
            if (_signals.TotalAI > 0) inputSignals.Add(("Аналоговые входы (AI)", _signals.TotalAI));
            if (_signals.TotalAO > 0) inputSignals.Add(("Аналоговые выходы (AO)", _signals.TotalAO));

            // 2. Генерируем массив байтов с помощью DocGenerator
            byte[] fileBytes = DocGenerator.GeneratePlcComparisonExcel(_tkpReport, inputSignals, _cabinetWidth);

            // Сборка b2b-имени файла
            string fileName = $"TKP_Comparison_PLC_{DateTime.Now:yyyyMMdd}.xlsx";

            // 3. Вызываем JS-функцию скачивания
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, Convert.ToBase64String(fileBytes));

            Snackbar.Add("ТКП успешно выгружено в Excel!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка скачивания файла: {ex.Message}", Severity.Error);
        }
    }
