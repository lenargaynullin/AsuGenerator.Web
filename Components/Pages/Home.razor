@page "/"
@using AsuGenerator.Web.Services
@using System.IO
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services.Strategies
@inject ExcelParserService Parser
@inject CalculationEngine Engine
@inject DocumentGenerator DocGen
@inject CabinetStrategyFactory StrategyFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Генератор спецификаций ШУВ</PageTitle>

<div class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary"><b>Генератор спецификаций шкафов автоматизации</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Автоматический подбор оборудования по параметрам. Скачивание спецификации в Excel.</MudText>

    <MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mb-6" PanelClass="pa-6">

        <MudTabPanel Text="Интерактивный подбор" Icon="@Icons.Material.Filled.SettingsSuggest">
            <MudGrid>
                <MudItem Xs="12" Md="12">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle1"><b>Параметры конфигурации шкафа:</b></MudText>

                        <MudExpansionPanel Text="Общие параметры шкафа" IsInitiallyExpanded="false" Class="mb-2">
                            <MudTabs Outlined="true" Position="Position.Top" Rounded="true" PanelClass="pa-4">
                                <MudTabPanel Text="Корпус">
                                    <div class="d-flex flex-column gap-3">
                                        
                                        <MudSelect T="string" Label="Тип монтажа" @bind-Value="baseConfig.MountType" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("Навесной")">Навесной</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string"
                                                   Label="Степень защиты"
                                                   Value="baseConfig.IpRating"
                                                   ValueChanged="OnIpRatingChanged"
                                                   Variant="Variant.Outlined"
                                                   Dense="true">
                                            <MudSelectItem Value="@("IP54")">IP54</MudSelectItem>
                                            <MudSelectItem Value="@("IP66")">IP66</MudSelectItem>
                                        </MudSelect>
                                        
                                            @if (baseConfig.IpRating == "IP54")
                                            {
                                                <MudSelect T="string" Label="Габариты шкафа (В×Ш×Г)" @bind-Value="selectedDimensions" Variant="Variant.Outlined" Dense="true">
                                                <MudSelectItem Value="@("400×300×220")">400×300×220 мм</MudSelectItem>
                                                <MudSelectItem Value="@("600×600×250")">600×600×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("800×650×250")">800×650×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1000×650×285")">1000×650×285 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1200×750×300")">1200×750×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1400×650×285")">1400×650×285 мм</MudSelectItem>
                                                </MudSelect>
                                            }
                                            else if (baseConfig.IpRating == "IP66")
                                            {
                                                <MudSelect T="string" Label="Габариты шкафа (В×Ш×Г)" @bind-Value="selectedDimensions" Variant="Variant.Outlined" Dense="true">
                                                <MudSelectItem Value="@("400×300×200")">400×300×200 мм</MudSelectItem>
                                                <MudSelectItem Value="@("600×400×250")">600×400×250 мм</MudSelectItem>
                                                <MudSelectItem Value="@("800×600×300")">800×600×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1000×800×300")">1000×800×300 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1200×800×400")">1200×800×400 мм</MudSelectItem>
                                                <MudSelectItem Value="@("1400×800×300")">1400×800×300 мм</MudSelectItem>
                                                </MudSelect>
                                            }

                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasHeater" Label="Обогрев шкафа" Color="Color.Primary" />
                                    </div>
                                </MudTabPanel>
                            </MudTabs>
                        </MudExpansionPanel>


                        <MudSelect T="string" Label="Тип проектируемого шкафа" @bind-Value="selectedCabinetType" Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem Value="@("Шкаф управления вентиляцией (ШУВ)")" />
                            <MudSelectItem Value="@("Шкаф управления электрообогревом (ШУЭ)")" />
                        </MudSelect>

                        
                        @if (selectedCabinetType.Contains("ШУВ")) 
                        {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Конфигурация ШУВ</MudText>

                        <MudSwitch T="bool" @bind-Value="supplyFan" Label="Приточный вентилятор" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasVfd" Label="Частотный преобразователь (ПЧВ)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasHeaterPump" Label="Насос калорифера (водяной нагрев)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasDamper" Label="Привод заслонки" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasHumidifierPump" Label="Насос увлажнителя" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasAirConditioner" Label="Блок кондиционера (ККБ)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="has3WayValve" Label="3-х ходовой клапан" Color="Color.Primary" />
                        }

                        
                        @if (selectedCabinetType.Contains("ШУЭ"))
                        {
                            <MudText Typo="Typo.subtitle1" Class="mt-4">Отходящие линии обогрева</MudText>

                            <MudSimpleTable Dense="true" Hover="true" Outlined="true">
                                <thead>
                                    <tr>
                                        <th>Вкл</th>
                                        <th>Поз.</th>
                                        <th>Диф.автомат</th>
                                        <th>Полюса</th>
                                        <th>Номинал, А</th>
                                        <th>Хар-ка</th>
                                        <th>кА</th>
                                        <th>Контактор</th>
                                        <th>Терморегулятор</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in heatingLines)
                                    {
                                        <tr>
                                            <td>
                                                <MudCheckBox @bind-Value="line.IsEnabled" Dense="true" />
                                            </td>
                                            <td>@line.Designation</td>
                                            <td>
                                                @if (line.Designation != "Вводной")
                                                {
                                                    <MudCheckBox @bind-Value="line.HasRCD" Dense="true" />
                                                }
                                            </td>
                                            <td>
                                                <MudSelect T="int" @bind-Value="line.Poles" Dense="true" Style="width:70px">
                                                    <MudSelectItem T="int" Value="1">1P</MudSelectItem>
                                                    <MudSelectItem T="int" Value="2">2P</MudSelectItem>
                                                    <MudSelectItem T="int" Value="3">3P</MudSelectItem>
                                                    <MudSelectItem T="int" Value="4">4P</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td>
                                                <MudSelect T="int" @bind-Value="line.Current" Dense="true" Style="width:80px">
                                                    <MudSelectItem T="int" Value="1">1 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="2">2 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="3">3 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="4">4 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="6">6 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="10">10 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="16">16 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="20">20 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="25">25 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="32">32 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="40">40 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="50">50 А</MudSelectItem>
                                                    <MudSelectItem T="int" Value="63">63 А</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td>
                                                <MudSelect T="string" @bind-Value="line.Curve" Dense="true" Style="width:60px">
                                                    <MudSelectItem T="string" Value="@("A")">A</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("B")">B</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("C")">C</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("D")">D</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td>
                                                <MudSelect T="double" @bind-Value="line.IkZ" Dense="true" Style="width:70px">
                                                    <MudSelectItem T="double" Value="4.5">4,5</MudSelectItem>
                                                    <MudSelectItem T="double" Value="6">6</MudSelectItem>
                                                    <MudSelectItem T="double" Value="10">10</MudSelectItem>
                                                </MudSelect>
                                            </td>
                                            <td>
                                                @if (line.Designation != "Вводной")
                                                {
                                                    <MudCheckBox @bind-Value="line.HasContactor" Dense="true" />
                                                }
                                            </td>
                                            <td>
                                                @if (line.Designation != "Вводной")
                                                {
                                                    <MudCheckBox @bind-Value="line.HasThermostat" Dense="true" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }


                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Build" OnClick="ProcessUiCalculation" Class="py-3 mt-2">
                            Рассчитать
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

    </MudTabs>

    @if (loadedConfig != null)
    {
        <MudCard Class="mt-6" Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Результаты подбора:</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (matchedComponents != null && matchedComponents.Any())
                {
                    <MudSimpleTable Dense="true" Hover="true" Outlined="true">
                        <thead>
                            <tr>
                                <th>Поз.</th>
                                <th>Бренд</th>
                                <th>Артикул</th>
                                <th>Наименование</th>
                                <th>Кол-во</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comp in matchedComponents)
                            {
                                <tr>
                                    <td><MudChip T="string" Color="Color.Info" Size="Size.Small">@comp.Designation</MudChip></td>
                                    <td>@comp.Vendor</td>
                                    <td><b>@comp.Article</b></td>
                                    <td>@comp.Description</td>
                                    <td>@comp.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudCardContent>
            <MudCardActions Class="pa-4">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="DownloadFile" FullWidth="true" Class="py-3">
                    Скачать спецификацию (Excel)
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
    <div style="border-top: 1px solid #e0e0e0; padding: 20px; margin-top: 40px; text-align: center; color: #555;">
        <p><b>AsuGenerator v1.0</b> — Автоматизация проектирования шкафов управления</p>
        <p>Разработчик: <b>Ленар Гайнуллин</b>, инженер-проектировщик АСУ ТП</p>
        <p>
            Telegram: <a href="https://t.me/t5522977" target="_blank">@@t5522977</a> |
            Email: <a href="mailto:powerman@mail.ru">powerman@mail.ru</a>
        </p>
        <p style="font-size: 0.85rem; color: #888;">
            Готов бесплатно адаптировать алгоритмы и шаблоны выгрузки Excel под стандарты вашего производства. Пишите!
        </p>
    </div>

</div>

@code {
    @code {
        private void OnIpRatingChanged(string newIpRating)
        {
            // Присваиваем новое значение степени защиты
            baseConfig.IpRating = newIpRating;

            // Выставляем нижнее (последнее) значение габаритов в зависимости от выбора
            if (newIpRating == "IP54")
            {
                selectedDimensions = "400×300×220";
            }
            else if (newIpRating == "IP66")
            {
                selectedDimensions = "400×300×200";
            }
        }
    }

    private BaseCabinetConfig baseConfig = new();

    private string selectedDimensions = "500×400×220";
    private string selectedCabinetType = "Шкаф управления вентиляцией (ШУВ)";
    private string heaterType = "Водяной";
    private VentAvtomatikaConfig? loadedConfig;
    private List<SelectedComponent> matchedComponents = new();
    private bool supplyFan = true;
    private bool hasVfd = false;
    private bool hasHeaterPump = false;
    private bool hasDamper = false;
    private bool hasHumidifierPump = false;
    private bool hasAirConditioner = false;
    private bool has3WayValve = false;
    private List<HeatingLine> heatingLines = new()
    {
        new() { Designation = "Вводной" },
        new() { Designation = "QF1" },
        new() { Designation = "QF2" },
        new() { Designation = "QF3" },
        new() { Designation = "QF4" },
        new() { Designation = "QF5" },
        new() { Designation = "QF6" },
        new() { Designation = "QF7" },
        new() { Designation = "QF8" },
        new() { Designation = "QF9" },
        new() { Designation = "QF10" },
        new() { Designation = "QF11" },
        new() { Designation = "QF12" },
    };
    private string _previousIp = "IP54";

    private void ProcessUiCalculation()
    {
        try
        {   
            var dims = selectedDimensions.Split('×');
            if (dims.Length == 3)
            {
                baseConfig.Height = int.Parse(dims[0]);
                baseConfig.Width = int.Parse(dims[1]);
                baseConfig.Depth = int.Parse(dims[2]);
            }



            var input = new UiConfigInput
            {
                SupplyFan = supplyFan,
                HasVfd = hasVfd,
                HasHeaterPump = hasHeaterPump,
                HasDamper = hasDamper,
                HasHumidifierPump = hasHumidifierPump,
                HasAirConditioner = hasAirConditioner,
                Has3WayValve = has3WayValve,
                TechnologyType = heaterType,
                ProjectNumber = "Конфиг-" + DateTime.Now.ToString("ddMM"),
                BaseConfig = baseConfig,
                HeatingLines = heatingLines.Where(l => l.IsEnabled).ToList()
            };

            loadedConfig = new VentAvtomatikaConfig
            {
                ClientName = "Конфигуратор",
                CompanyName = "AsuGenerator",
                KpNumber = input.ProjectNumber
            };

            ICabinetStrategy strategy = StrategyFactory.GetStrategy(selectedCabinetType);
            matchedComponents = strategy.CalculateComponents(input);
        }
        catch (Exception ex)
        {
            loadedConfig = new VentAvtomatikaConfig { ClientName = "ОШИБКА", CompanyName = ex.GetType().Name, KpNumber = ex.Message };
            matchedComponents = new();
        }
    }

    private async Task DownloadFile()
    {
        if (loadedConfig == null || matchedComponents == null || !matchedComponents.Any()) return;

        try
        {
            byte[] excelBytes = DocGen.GenerateExcelSpecification(matchedComponents, loadedConfig);
            string fileName = $"Спецификация_{loadedConfig.KpNumber}.xlsx";

            using var fileStream = new MemoryStream(excelBytes);
            using var streamRef = new DotNetStreamReference(stream: fileStream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}