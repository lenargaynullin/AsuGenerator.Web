@page "/"
@using AsuGenerator.Web.Services
@using System.IO
@using AsuGenerator.Web.Models
@using AsuGenerator.Web.Services.Strategies
@inject ExcelParserService Parser
@inject CalculationEngine Engine
@inject DocumentGenerator DocGen
@inject CabinetStrategyFactory StrategyFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Генератор спецификаций ШУВ</PageTitle>

<div class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-2" Color="Color.Primary"><b>Генератор спецификаций шкафов автоматизации</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Автоматический подбор оборудования по параметрам. Скачивание спецификации в Excel.</MudText>

    <MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mb-6" PanelClass="pa-6">

        <MudTabPanel Text="Интерактивный подбор" Icon="@Icons.Material.Filled.SettingsSuggest">
            <MudGrid>
                <MudItem Xs="12" Md="5">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle1"><b>Параметры конфигурации шкафа:</b></MudText>

                        <MudExpansionPanel Text="Общие параметры шкафа" IsInitiallyExpanded="false" Class="mb-2">
                            <MudTabs Outlined="true" Position="Position.Top" Rounded="true" PanelClass="pa-4">
                                <MudTabPanel Text="Корпус">
                                    <div class="d-flex flex-column gap-3">
                                        <MudSelect T="string" Label="Тип монтажа" @bind-Value="baseConfig.MountType" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("Навесной")">Навесной</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string" Label="Степень защиты" @bind-Value="baseConfig.IpRating" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("IP54")">IP54</MudSelectItem>
                                        </MudSelect>
                                        <MudText Typo="Typo.caption">Габариты шкафа (мм)</MudText>
                                        <div class="d-flex gap-2">
                                            <MudNumericField T="int" Label="Высота" @bind-Value="baseConfig.Height" Variant="Variant.Outlined" Dense="true" />
                                            <MudNumericField T="int" Label="Ширина" @bind-Value="baseConfig.Width" Variant="Variant.Outlined" Dense="true" />
                                            <MudNumericField T="int" Label="Глубина" @bind-Value="baseConfig.Depth" Variant="Variant.Outlined" Dense="true" />
                                        </div>

                                        <MudSwitch T="bool" @bind-Value="baseConfig.HasHeater" Label="Обогрев шкафа" Color="Color.Primary" />
                                    </div>
                                </MudTabPanel>
                                <MudTabPanel Text="Электрика и управление">
                                    <div class="d-flex flex-column gap-3">
                                        <MudRadioGroup T="string" @bind-Value="baseConfig.Voltage" Class="d-flex flex-column gap-1">
                                            <MudText Typo="Typo.caption">Напряжение питания</MudText>
                                            <MudRadio Value="@("380")" Color="Color.Primary" Dense="true">380 В</MudRadio>
                                            <MudRadio Value="@("220")" Color="Color.Primary" Dense="true">220 В</MudRadio>
                                        </MudRadioGroup>
                                        <MudNumericField T="int" Label="Ток ввода (А)" @bind-Value="baseConfig.InputCurrent" Variant="Variant.Outlined" Dense="true" />
                                        <MudSelect T="string" Label="Контроллер" @bind-Value="baseConfig.PlcType" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("ПР200")">ПР200</MudSelectItem>
                                            <MudSelectItem Value="@("ПЛК110")">ПЛК110</MudSelectItem>
                                            <MudSelectItem Value="@("ПЛК160")">ПЛК160</MudSelectItem>
                                        </MudSelect>
                                        <MudSelect T="string" Label="Протокол связи" @bind-Value="baseConfig.Protocol" Variant="Variant.Outlined" Dense="true">
                                            <MudSelectItem Value="@("Modbus RTU")">Modbus RTU</MudSelectItem>
                                            <MudSelectItem Value="@("Modbus TCP")">Modbus TCP</MudSelectItem>
                                            <MudSelectItem Value="@("Нет")">Нет</MudSelectItem>
                                        </MudSelect>
                                    </div>
                                </MudTabPanel>
                            </MudTabs>
                        </MudExpansionPanel>


                        <MudSelect T="string" Label="Тип проектируемого шкафа" @bind-Value="selectedCabinetType" Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem Value="@("Шкаф управления вентиляцией (ШУВ)")" />
                        </MudSelect>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Конфигурация ШУВ</MudText>

                        <MudSwitch T="bool" @bind-Value="supplyFan" Label="Приточный вентилятор" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasVfd" Label="Частотный преобразователь (ПЧВ)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasHeaterPump" Label="Насос калорифера (водяной нагрев)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasDamper" Label="Привод заслонки" Color="Color.Primary" />

                        <MudSwitch T="bool" @bind-Value="hasHumidifierPump" Label="Насос увлажнителя" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="hasAirConditioner" Label="Блок кондиционера (ККБ)" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="has3WayValve" Label="3-х ходовой клапан" Color="Color.Primary" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Build" OnClick="ProcessUiCalculation" Class="py-3 mt-2">
                            Рассчитать
                        </MudButton>
                    </div>
                </MudItem>

                <MudItem Xs="12" Md="7" Class="d-flex align-center justify-center">
                    <div class="d-flex flex-column justify-center align-center border-2 border-dashed rounded pa-4" Style="border-style: dashed; height: 180px; width: 100%; background-color: #fafafa;">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Style="font-size: 2.5rem;" Color="Color.Primary" Class="mb-1" />
                        <MudText Typo="Typo.body2" Align="Align.Center">Настройте параметры слева и нажмите «Рассчитать».</MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

    </MudTabs>

    @if (loadedConfig != null)
    {
        <MudCard Class="mt-6" Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Результаты подбора:</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (matchedComponents != null && matchedComponents.Any())
                {
                    <MudSimpleTable Dense="true" Hover="true" Outlined="true">
                        <thead>
                            <tr>
                                <th>Поз.</th>
                                <th>Бренд</th>
                                <th>Артикул</th>
                                <th>Наименование</th>
                                <th>Кол-во</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comp in matchedComponents)
                            {
                                <tr>
                                    <td><MudChip T="string" Color="Color.Info" Size="Size.Small">@comp.Designation</MudChip></td>
                                    <td>@comp.Vendor</td>
                                    <td><b>@comp.Article</b></td>
                                    <td>@comp.Description</td>
                                    <td>@comp.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudCardContent>
            <MudCardActions Class="pa-4">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="DownloadFile" FullWidth="true" Class="py-3">
                    Скачать спецификацию (Excel)
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</div>

@code {
    private BaseCabinetConfig baseConfig = new();
    private string selectedCabinetType = "Шкаф управления вентиляцией (ШУВ)";
    private string heaterType = "Водяной";
    private VentAvtomatikaConfig? loadedConfig;
    private List<SelectedComponent> matchedComponents = new();
    private bool supplyFan = true;
    private bool hasVfd = false;
    private bool hasHeaterPump = false;
    private bool hasDamper = false;
    private bool hasHumidifierPump = false;
    private bool hasAirConditioner = false;
    private bool has3WayValve = false;

    private void ProcessUiCalculation()
    {
        try
        {
            var input = new UiConfigInput
            {
                SupplyFan = supplyFan,
                HasVfd = hasVfd,
                HasHeaterPump = hasHeaterPump,
                HasDamper = hasDamper,
                TechnologyType = heaterType,
                ProjectNumber = "Конфиг-" + DateTime.Now.ToString("ddMM"),
                BaseConfig = baseConfig
            };

            loadedConfig = new VentAvtomatikaConfig
            {
                ClientName = "Конфигуратор",
                CompanyName = "AsuGenerator",
                KpNumber = input.ProjectNumber,
                Heater1Type = $"{heaterType} нагреватель",
                HeaterEl1Voltage = baseConfig.Voltage
            };

            ICabinetStrategy strategy = StrategyFactory.GetStrategy(selectedCabinetType);
            matchedComponents = strategy.CalculateComponents(input);
        }
        catch (Exception ex)
        {
            loadedConfig = new VentAvtomatikaConfig
            {
                ClientName = "ОШИБКА",
                CompanyName = ex.GetType().Name,
                KpNumber = ex.Message
            };
            matchedComponents = new();
        }
    }

    private async Task DownloadFile()
    {
        if (loadedConfig == null || matchedComponents == null || !matchedComponents.Any()) return;

        try
        {
            byte[] excelBytes = DocGen.GenerateExcelSpecification(matchedComponents, loadedConfig);
            string fileName = $"Спецификация_{loadedConfig.KpNumber}.xlsx";

            using var fileStream = new MemoryStream(excelBytes);
            using var streamRef = new DotNetStreamReference(stream: fileStream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}